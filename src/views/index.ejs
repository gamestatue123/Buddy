async function refreshAICoach(force=false,metricsOverride=null){
    const coachEl=document.getElementById('aiCoachText');
    if(!coachEl)return;
    if(window.__aiCoachBusy)return;
    const now=Date.now();
    const cachedText=localStorage.getItem('buddy_ai_coach_text');
    const cachedTs=Number(localStorage.getItem('buddy_ai_coach_ts')||0);
    if(!force&&cachedText&&(now-cachedTs)<15*60*1000){coachEl.textContent=cachedText;return;}

    const metrics=metricsOverride||{
        score:document.getElementById('aiHealthScore')?.textContent||'0%',
        avgTestPct:0,pendingTasks:0,backlogOpen:0,syllabusPct:0,dppTotal:0,scheduleCount:0
    };
    const prompt=`You are a strict but supportive JEE study coach. Use this student snapshot and give exactly 3 short personalized action bullets for next 24 hours. Data: focus_score=${metrics.score}, avg_test_pct=${metrics.avgTestPct}, pending_tasks=${metrics.pendingTasks}, backlog_open=${metrics.backlogOpen}, syllabus_pct=${metrics.syllabusPct}, dpp_total=${metrics.dppTotal}, schedule_slots=${metrics.scheduleCount}. Keep concise and practical.`;
    coachEl.textContent='Running real AI analysis...';
    window.__aiCoachBusy=true;
    try{
        let aiText=await callAIProviders(prompt);
        if(!aiText){
            aiText=`AI provider not reachable right now. Add an API key for reliable responses (OpenRouter/HuggingFace) and retry. Fallback plan: clear 2 top backlog items, run one timed mixed test block, and review today's top 10 mistakes.`;
        }
        const cleaned=aiText.replace(/\s+/g,' ').slice(0,420);
        coachEl.textContent=cleaned;
        localStorage.setItem('buddy_ai_coach_text',cleaned);
        localStorage.setItem('buddy_ai_coach_ts',String(now));
    } finally {
        window.__aiCoachBusy=false;
    }
}

async function callAIProviders(prompt){
    if(BUDDY_AI_CONFIG.openRouterKey){
        try{
            const r=await fetch('https://openrouter.ai/api/v1/chat/completions',{
                method:'POST',
                headers:{'Content-Type':'application/json','Authorization':`Bearer ${BUDDY_AI_CONFIG.openRouterKey}`},
                body:JSON.stringify({model:OPENROUTER_MODEL,messages:[{role:'user',content:prompt}],max_tokens:220,temperature:0.6})
            });
            if(r.ok){
                const d=await r.json();
                const t=d?.choices?.[0]?.message?.content?.trim();
                if(t)return t;
            }
        }catch(e){}
    }
    const models=['deepseek-ai/DeepSeek-R1-Distill-Qwen-7B','Qwen/Qwen2.5-7B-Instruct','mistralai/Mistral-7B-Instruct-v0.3'];
    for(const model of models){
        try{
            const ctrl=new AbortController();
            const timeout=setTimeout(()=>ctrl.abort(),9000);
            const headers={'Content-Type':'application/json'};
            if(BUDDY_AI_CONFIG.huggingFaceKey)headers.Authorization=`Bearer ${BUDDY_AI_CONFIG.huggingFaceKey}`;
            const res=await fetch(`https://api-inference.huggingface.co/models/${model}`,{
                method:'POST',
                headers,
                body:JSON.stringify({inputs:prompt,parameters:{max_new_tokens:130,temperature:0.5,return_full_text:false}}),
                signal:ctrl.signal
            });
            clearTimeout(timeout);
            if(!res.ok)continue;
            const data=await res.json();
            const out=(Array.isArray(data)?data?.[0]?.generated_text:data?.generated_text||'').trim();
            if(out&&out.length>20)return out;
        }catch(e){}
    }
    return '';
}

function readAIChat(){return readJsonArray('buddy_ai_chat');}
function writeAIChat(list){localStorage.setItem('buddy_ai_chat',JSON.stringify(list.slice(-20)));}
function renderAIChat(){
    const host=document.getElementById('aiChatLog');if(!host)return;
    const msgs=readAIChat();
    if(!msgs.length){host.innerHTML='<div class="ai-chat-msg ai">Ask me anything about your prep and I will answer based on your current dashboard data.</div>';return;}
    host.innerHTML=msgs.map(m=>`<div class="ai-chat-msg ${m.role==='user'?'user':'ai'}">${esc(m.text)}</div>`).join('');
    host.scrollTop=host.scrollHeight;
}
async function sendAIChatMessage(){
    const input=document.getElementById('aiChatInput');if(!input)return;
    const q=input.value.trim();if(!q)return;
    input.value='';
    const chat=readAIChat();
    chat.push({role:'user',text:q,ts:new Date().toISOString()});
    writeAIChat(chat); renderAIChat();
    const ctx=`Student snapshot: ${document.getElementById('aiHealthScore')?.textContent||'0%'} focus score, backlog open ${readJsonArray('buddy_backlog').filter(i=>!i.done).length}, pending tasks ${readJsonArray('buddy_tasks').filter(t=>!t.completed).length}.`;
    const prompt=`You are Buddy AI study mentor. Answer clearly in under 120 words. ${ctx}\nQuestion: ${q}`;
    let answer=await callAIProviders(prompt);
    if(!answer)answer='I could not reach an AI provider. Add OpenRouter/HuggingFace key and try again.';
    const next=readAIChat();
    next.push({role:'ai',text:answer.replace(/\s+/g,' ').slice(0,520),ts:new Date().toISOString()});
    writeAIChat(next); renderAIChat();
}

