let chatMode='public',chatUnsubs=[],chatMessages=[],chatPresence=[];
let secretInviteCode=localStorage.getItem(CHAT_SECRET_STORAGE_KEY)||'';
const chatGuestId=localStorage.getItem('buddy_chat_guest_id')||(`guest_${Math.random().toString(36).slice(2,10)}`);
localStorage.setItem('buddy_chat_guest_id',chatGuestId);

function _chatEsc(v){return (v==null?'':String(v)).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function _chatDisplayName(){return _cu?.displayName||_cu?.email?.split('@')[0]||'Anonymous';}
function _chatActorId(){return _cu?.uid||chatGuestId;}
function _chatActorName(){return _cu?.displayName||_cu?.email?.split('@')[0]||'Guest';}
function _fmtHM(ts){if(!ts)return '';const d=ts?.toDate?ts.toDate():new Date(ts);return d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});}
function _makeSecretCode(uid=''){const seed=`${uid||'local'}|${CHAT_UNLOCK_DATE}|${CHAT_UNLOCK_NAME}`;let h=2166136261;for(let i=0;i<seed.length;i++){h^=seed.charCodeAt(i);h+=((h<<1)+(h<<4)+(h<<7)+(h<<8)+(h<<24));}return `INF-${Math.abs(h>>>0).toString(36).toUpperCase().slice(0,8)}`;}
function isSecretUnlocked(){
    if(secretInviteCode)return true;
    try{
        const tests=JSON.parse(localStorage.getItem('test_analysis_data')||'[]');
        const ok=tests.some(t=>(t?.date||'')===CHAT_UNLOCK_DATE && ((t?.testName||t?.name||'').trim().toLowerCase()===CHAT_UNLOCK_NAME));
        if(ok){secretInviteCode=_makeSecretCode(_cu?.uid||'');localStorage.setItem(CHAT_SECRET_STORAGE_KEY,secretInviteCode);return true;}
    }catch(e){}
    return false;
}
function _chatRoomId(){
    if(chatMode!=='secret') return 'buddy-public';
    if(!isSecretUnlocked()) return '';
    return `buddy-infinity-${(secretInviteCode||'none').toLowerCase()}`;
}
function _clearChatSubs(){chatUnsubs.forEach(fn=>{try{fn();}catch(e){}});chatUnsubs=[];}
function _renderChatMessages(){
    const host=document.getElementById('buddyChatLog');if(!host)return;
    if(!chatMessages.length){host.innerHTML='<div class="chat-row"><div>No messages yet. Start the conversation 🚀</div></div>';return;}
    host.innerHTML=chatMessages.map(m=>`<div class="chat-row ${m.uid===_cu?.uid?'me':''}"><div>${_chatEsc(m.text||'')}</div><div class="chat-meta">${_chatEsc(m.name||'Guest')} · ${_fmtHM(m.createdAt)}</div></div>`).join('');
    host.scrollTop=host.scrollHeight;
}
async function _claimSecretSeat(){
    const roomId=_chatRoomId(); if(!roomId) return false;
    const actorId=_chatActorId();
    const db=firebase.firestore();
    const roomRef=db.collection('chatrooms').doc(roomId);
    try{
        const ok=await db.runTransaction(async tx=>{
            const snap=await tx.get(roomRef);
            const data=snap.exists?snap.data():{};
            const participants=Array.isArray(data.participants)?data.participants:[];
            if(!participants.includes(actorId) && participants.length>=2) return false;
            const next=participants.includes(actorId)?participants:[...participants,actorId];
            tx.set(roomRef,{type:'secret',code:secretInviteCode,participants:next,updatedAt:firebase.firestore.FieldValue.serverTimestamp()},{merge:true});
            tx.set(roomRef.collection('presence').doc(actorId),{uid:actorId,name:_chatActorName(),lastSeen:firebase.firestore.FieldValue.serverTimestamp()},{merge:true});
            return true;
        });
        return ok;
    }catch(e){return false;}
}
function _listenChatRoom(){
    const rid=_chatRoomId();
    const log=document.getElementById('buddyChatLog');
    if(!rid){if(log)log.innerHTML='<div class="chat-row">Room unavailable right now.</div>';return;}
    const db=firebase.firestore();
    const roomRef=db.collection('chatrooms').doc(rid);
    const msgQ=roomRef.collection('messages').orderBy('createdAt','asc').limitToLast(120);
    const pQ=roomRef.collection('presence').orderBy('lastSeen','desc').limit(10);
    chatUnsubs.push(msgQ.onSnapshot(snap=>{chatMessages=[];snap.forEach(d=>chatMessages.push({id:d.id,...d.data()}));_renderChatMessages();}));
    chatUnsubs.push(pQ.onSnapshot(snap=>{
        chatPresence=[];snap.forEach(d=>chatPresence.push(d.data()));
        const online=chatPresence.length;
        const isSecret=chatMode==='secret';
        document.getElementById('chatPresenceText').textContent=isSecret?`${online}/2 seats active`:`${online} online`;
        document.getElementById('publicCountPill') && (document.getElementById('publicCountPill').textContent=String(online));
    }));
}
async function refreshBuddyChatRoom(){
    _clearChatSubs();
    chatMessages=[];_renderChatMessages();
    const system=document.getElementById('chatSystemText');
    const unlocked=isSecretUnlocked();
    if(chatMode==='secret'){
        if(!unlocked){closeBuddyChatRoom();return;}
        const ok=await _claimSecretSeat();
        if(!ok){if(system)system.textContent='Room is full (2/2). Try later.';document.getElementById('buddyChatLog').innerHTML='<div class="chat-row">⚠️ This room is currently full.</div>';return;}
    }
    if(system)system.textContent=chatMode==='secret'?'Private room active.':'Public room open to everyone.';
    _listenChatRoom();
}
function switchBuddyRoom(mode){
    chatMode=mode==='secret'?'secret':'public';
    document.getElementById('chatPublicBtn')?.classList.toggle('active',chatMode==='public');
    document.getElementById('chatRoomTitle').textContent=chatMode==='secret'?'PRIVATE ROOM':'PUBLIC CHAT';
    document.getElementById('chatRoomSubtitle').textContent=chatMode==='secret'?'Realtime room · 2 concurrent users max.':'Discuss prep, ask doubts, motivate each other.';
    refreshBuddyChatRoom();
}
function openBuddyChatRoom(){document.getElementById('buddyChatModal')?.classList.add('open');switchBuddyRoom('public');}
function openInfinityRoomSilently(){document.getElementById('buddyChatModal')?.classList.add('open');switchBuddyRoom('secret');}
function _releaseSecretSeat(){
    if(chatMode!=='secret') return;
    const rid=_chatRoomId(); if(!rid) return;
    const roomRef=firebase.firestore().collection('chatrooms').doc(rid);
    roomRef.collection('presence').doc(_chatActorId()).delete().catch(()=>{});
}
function closeBuddyChatRoom(){_releaseSecretSeat();_clearChatSubs();document.getElementById('buddyChatModal')?.classList.remove('open');}
async function sendBuddyChatMessage(){
    const input=document.getElementById('buddyChatInput');
    const text=input?.value?.trim(); if(!text)return;
    if(chatMode==='secret' && !isSecretUnlocked()){showToastMsg('Unlock secret room first');return;}
    const rid=_chatRoomId(); if(!rid)return;
    try{
        await firebase.firestore().collection('chatrooms').doc(rid).collection('messages').add({
            text:text.slice(0,480),uid:_chatActorId(),name:_chatActorName(),
            createdAt:firebase.firestore.FieldValue.serverTimestamp()
        });
        input.value='';
    }catch(e){showToastMsg('Could not send message');}
}
function initChatLauncher(){
    document.getElementById('buddyChatModal')?.addEventListener('click',e=>{if(e.target.id==='buddyChatModal')closeBuddyChatRoom();});
    document.getElementById('buddyChatInput')?.addEventListener('keydown',e=>{if(e.key==='Enter')sendBuddyChatMessage();});
    window.addEventListener('beforeunload',_releaseSecretSeat);
    if(!secretInviteCode && _cu?.uid){secretInviteCode=_makeSecretCode(_cu.uid);localStorage.setItem(CHAT_SECRET_STORAGE_KEY,secretInviteCode);}
    const qp=new URLSearchParams(location.search);
    const auto=qp.get('chat')==='infinity' || localStorage.getItem(CHAT_AUTO_INFTY_KEY)==='1';
    if(auto && isSecretUnlocked()){
        localStorage.removeItem(CHAT_AUTO_INFTY_KEY);
        setTimeout(()=>openInfinityRoomSilently(),120);
        if(qp.get('chat')==='infinity'){
            const url=new URL(location.href);url.searchParams.delete('chat');history.replaceState({},'',url.pathname+url.search+url.hash);
        }
    }
}

function showScreen(id){document.querySelectorAll('.auth-screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');}
function closeOverlay(){document.getElementById('authOverlay').classList.remove('show');}
function openOverlay(){document.getElementById('authOverlay').classList.add('show');}

// Profile setup modal — JEE year + prep type
