// Upcoming Tests Widget
function loadUpcomingTests(){
    let tests=[];
    // timetable.ejs writes to 'buddy_tests' (LS_TESTS = 'buddy_tests')
    // also check active_test_plan for legacy/other pages, but never use it for the JEE countdown
    try{
        const raw=localStorage.getItem('buddy_tests');
        if(raw) tests=JSON.parse(raw);
    }catch(e){}
    // fallbacks for other possible keys
    if(!tests.length){
        for(const key of ['tests','buddy_tests_scheduled','tests_data']){
            try{const r=localStorage.getItem(key);if(r){const parsed=JSON.parse(r);if(Array.isArray(parsed)&&parsed.length){tests=parsed;break;}}}catch(e){}
        }
    }



    const today=new Date();today.setHours(0,0,0,0);
    // Filter to upcoming (today or future) and sort by date ascending
    const upcoming=tests
        .filter(t=>{if(!t.date)return false;const d=new Date(t.date);d.setHours(0,0,0,0);return d>=today;})
        .sort((a,b)=>new Date(a.date)-new Date(b.date));
    const past=tests
        .filter(t=>{if(!t.date)return false;const d=new Date(t.date);d.setHours(0,0,0,0);return d<today;})
        .sort((a,b)=>new Date(b.date)-new Date(a.date));

    const badge=document.getElementById('upTestsBadge');
    if(badge){badge.textContent=upcoming.length+' SCHEDULED';}
    const body=document.getElementById('upTestsBody');if(!body)return;

    if(!tests.length){
        body.innerHTML=`<div class="empty-card"><div class="empty-ico">📅</div><div class="empty-t">No tests scheduled · Go to Timetable to add one</div></div>`;
        return;
    }

    const SUBJ_COLS={Physics:'var(--phys)',Chemistry:'var(--chem)',Mathematics:'var(--math)',Maths:'var(--math)',Math:'var(--math)'};

    function urgencyStyle(daysLeft){
        if(daysLeft<=0)return{col:'var(--red)',label:'TODAY',bg:'rgba(240,68,68,0.12)',border:'rgba(240,68,68,0.3)'};
        if(daysLeft===1)return{col:'var(--red)',label:'TOMORROW',bg:'rgba(240,68,68,0.08)',border:'rgba(240,68,68,0.2)'};
        if(daysLeft<=3)return{col:'var(--amber)',label:daysLeft+'d LEFT',bg:'rgba(245,166,35,0.08)',border:'rgba(245,166,35,0.2)'};
        if(daysLeft<=7)return{col:'var(--vio)',label:daysLeft+'d LEFT',bg:'rgba(167,139,250,0.07)',border:'rgba(167,139,250,0.18)'};
        return{col:'var(--fg3)',label:daysLeft+'d LEFT',bg:'rgba(255,255,255,0.025)',border:'var(--bd)'};
    }

    let html='';

    if(upcoming.length){
        // Next test — big featured card
        const next=upcoming[0];
        const nextDate=new Date(next.date);nextDate.setHours(0,0,0,0);
        const daysLeft=Math.round((nextDate-today)/86400000);
        const u=urgencyStyle(daysLeft);
        const chapters=(next.chapters||[]);
        const completed=(next.completedChapters||[]).length;
        const total=chapters.length;
        const prepPct=total?Math.round(completed/total*100):0;

        // Build subject pills from chapters or syllabus string
        const syllabusStr=next.syllabus||chapters.join(', ')||'';
        const subjectMentions=[];
        if(syllabusStr.toLowerCase().includes('physics')||chapters.some(c=>c.match(/kinematics|motion|force|energy|work|wave|optics|thermo|electro|magnet|fluid|SHM|rotat/i)))subjectMentions.push('Physics');
        if(syllabusStr.toLowerCase().includes('chemistry')||chapters.some(c=>c.match(/organic|inorganic|atomic|bonding|equilib|mole|acid|redox|stereo|periodic|IUPAC/i)))subjectMentions.push('Chemistry');
        if(syllabusStr.toLowerCase().includes('math')||chapters.some(c=>c.match(/quadratic|trigo|log|matrix|vector|calcul|limit|integr|differenti|permut|probab|complex|straight|circle/i)))subjectMentions.push('Maths');

        html+=`<div style="padding:12px 13px;background:${u.bg};border:1px solid ${u.border};border-radius:var(--r3);margin-bottom:10px;position:relative;overflow:hidden;">
          <div style="position:absolute;top:0;left:0;bottom:0;width:3px;background:${u.col};border-radius:3px 0 0 3px;"></div>
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px;padding-left:8px;">
            <div style="flex:1;min-width:0;">
              <div style="font-family:var(--fd);font-size:1.05rem;letter-spacing:0.06em;color:var(--fg1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(next.name||'Unnamed Test')}</div>
              <div style="font-family:var(--fm);font-size:0.58rem;color:var(--fg3);margin-top:2px;">${nextDate.toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short'})}</div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
              <div style="font-family:var(--fd);font-size:1.6rem;line-height:1;color:${u.col};">${daysLeft<=0?'0':daysLeft}</div>
              <div style="font-family:var(--fm);font-size:0.5rem;color:${u.col};letter-spacing:0.08em;">${u.label}</div>
            </div>
          </div>
          ${total?`<div style="padding-left:8px;margin-bottom:6px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
              <div style="font-family:var(--fm);font-size:0.56rem;color:var(--fg3);letter-spacing:0.06em;">SYLLABUS PREP</div>
              <div style="font-family:var(--fm);font-size:0.58rem;color:${prepPct>=80?'var(--grn)':prepPct>=50?'var(--amber)':'var(--red)'};">${completed}/${total} · ${prepPct}%</div>
            </div>
            <div style="height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden;">
              <div style="width:${prepPct}%;height:100%;background:${prepPct>=80?'var(--grn)':prepPct>=50?'var(--amber)':'var(--red)'};border-radius:2px;transition:width 0.6s ease;"></div>
            </div>
          </div>`:''}
          ${subjectMentions.length?`<div style="display:flex;gap:5px;padding-left:8px;flex-wrap:wrap;">
            ${subjectMentions.map(s=>`<span style="font-family:var(--fm);font-size:0.54rem;padding:2px 7px;border-radius:50px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:${SUBJ_COLS[s]||'var(--fg3)'};">${s}</span>`).join('')}
          </div>`:''}
        </div>`;

        // Remaining upcoming (compact rows)
        upcoming.slice(1,4).forEach(t=>{
            const td=new Date(t.date);td.setHours(0,0,0,0);
            const dl=Math.round((td-today)/86400000);
            const u2=urgencyStyle(dl);
            const ch2=(t.chapters||[]);const cp2=(t.completedChapters||[]).length;
            html+=`<div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:rgba(255,255,255,0.025);border:1px solid var(--bd);border-radius:var(--r2);margin-bottom:5px;transition:background 0.13s;" onmouseover="this.style.background='rgba(255,255,255,0.045)'" onmouseout="this.style.background='rgba(255,255,255,0.025)'">
              <div style="width:3px;height:36px;border-radius:2px;background:${u2.col};flex-shrink:0;"></div>
              <div style="flex:1;min-width:0;">
                <div style="font-size:0.78rem;font-weight:500;color:var(--fg1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(t.name||'Test')}</div>
                <div style="font-family:var(--fm);font-size:0.55rem;color:var(--fg3);margin-top:2px;">${td.toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short'})}${ch2.length?' · '+cp2+'/'+ch2.length+' chapters':''}</div>
              </div>
              <div style="text-align:right;flex-shrink:0;">
                <div style="font-family:var(--fd);font-size:1.1rem;color:${u2.col};line-height:1;">${dl}</div>
                <div style="font-family:var(--fm);font-size:0.5rem;color:${u2.col};letter-spacing:0.06em;">DAYS</div>
              </div>
            </div>`;
        });
        if(upcoming.length>4){
            html+=`<div style="font-family:var(--fm);font-size:0.6rem;color:var(--fg3);text-align:center;padding:6px 0;">+ ${upcoming.length-4} more upcoming tests</div>`;
        }
    } else {
        html+=`<div class="empty-card" style="padding:1rem 0 0.4rem;"><div class="empty-ico">✅</div><div class="empty-t">No upcoming tests · All clear!</div></div>`;
    }

    // Last completed test (1 row, greyed out)
    if(past.length){
        const p=past[0];
        const pd=new Date(p.date);
        const daysAgo=Math.round((today-pd)/86400000);
        html+=`<div style="margin-top:8px;padding-top:8px;border-top:1px solid var(--bd);">
          <div style="font-family:var(--fm);font-size:0.54rem;letter-spacing:0.08em;color:var(--fg3);text-transform:uppercase;margin-bottom:6px;">LAST COMPLETED</div>
