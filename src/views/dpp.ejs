    <img src="/logo.png" style="width:28px;height:28px;border-radius:7px;object-fit:cover;flex-shrink:0;" onerror="this.style.display='none'" alt="">
    <span style="font-family:'Bebas Neue',sans-serif;font-size:1.05rem;letter-spacing:0.1em;color:#e8ebf8;">DPP LOGGER</span>
  </div>
  <div id="_mRight" style="display:flex;align-items:center;gap:8px;"></div>
</header>

<nav class="mob-tabbar">
  <a href="/" class="mob-tab"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 9L12 3L21 9V20C21 20.55 20.55 21 20 21H15V15H9V21H4C3.45 21 3 20.55 3 20V9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span>Home</span></a>
  <a href="/timetable" class="mob-tab"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2V6M8 2V6M3 10H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Tasks</span></a>
  <a href="/dpp" class="mob-tab mob-active"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>DPP</span></a>
  <a href="/syllabus" class="mob-tab"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 4H20V20H4V4Z" stroke="currentColor" stroke-width="1.5"/><path d="M8 7H16M8 11H14M8 15H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Syllabus</span></a>
  <a href="/test-analysis" class="mob-tab"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Tests</span></a>
</nav>

<div class="mob-drawer-bd" id="_mdbd"></div>
<div class="mob-drawer" id="_mdrw">
  <div style="display:flex;justify-content:center;padding:10px 0 6px;">
    <div style="width:36px;height:4px;background:rgba(255,255,255,0.15);border-radius:2px;"></div>
  </div>
  <div id="_mdc" style="padding:0 16px 12px;"></div>
</div>

<style>
/* ── Mob topbar inner styles (not layout) ── */
#_mRight button {
  padding: 7px 13px;
  background: rgba(91,110,245,0.14);
  border: 1px solid rgba(91,110,245,0.28);
  border-radius: 20px;
  color: #7c8ff8;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.06em;
  cursor: pointer;
  white-space: nowrap;
}
._mav {
  width: 32px; height: 32px; border-radius: 50%;
  background: linear-gradient(135deg,#5b6ef5,#a78bfa);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Bebas Neue',sans-serif; font-size: 1.1rem; color: #fff;
  cursor: pointer; flex-shrink: 0;
}
._mduser {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 16px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 14px;
  margin-bottom: 12px;
}
._mdav2 {
  width: 44px; height: 44px; border-radius: 50%;
  background: linear-gradient(135deg,#5b6ef5,#a78bfa);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Bebas Neue',sans-serif; font-size: 1.4rem; color: #fff;
  flex-shrink: 0;
}
._mdbtn {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 16px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  color: rgba(255,255,255,0.6);
  cursor: pointer; font-family: 'Outfit',sans-serif;
  font-size: 0.88rem; font-weight: 500;
  margin-bottom: 8px; width: 100%; text-align: left;
  transition: background 0.12s;
}
._mdbtn:active { background: rgba(255,255,255,0.07); }
._mdbtn.red { color: #f04444; border-color: rgba(240,68,68,0.15); }
._mdbtn.red:active { background: rgba(240,68,68,0.08); }
._mdbtn.blu { background: rgba(91,110,245,0.1); border-color: rgba(91,110,245,0.22); color: #7c8ff8; }
</style>

<script>
(function() {
  if (window.innerWidth > 768) return;

  var bd   = document.getElementById('_mbd');
  var menu = document.getElementById('_mMenu');
  var sb   = document.getElementById('buddySidebar') || document.querySelector('.sidebar');
  var mdr  = document.getElementById('_mdrw');
  var mdbd = document.getElementById('_mdbd');
  var mrt  = document.getElementById('_mRight');
  var mdc  = document.getElementById('_mdc');

  // ── Sidebar open/close ──
  function openSb() {
    if(sb) sb.classList.add('mob-open');
    if(bd) bd.classList.add('on');
  }
  function closeSb() {
    if(sb) sb.classList.remove('mob-open');
    if(bd) bd.classList.remove('on');
  }
  menu && menu.addEventListener('click', openSb);
  bd   && bd.addEventListener('click', closeSb);
  document.querySelectorAll('.sidebar .nav-item, .sidebar a').forEach(function(a) {
    a.addEventListener('click', closeSb);
  });

  // swipe left to close sidebar
  var tx = 0;
  document.addEventListener('touchstart', function(e){ tx = e.touches[0].clientX; }, {passive:true});
  document.addEventListener('touchend', function(e){
    if(e.changedTouches[0].clientX - tx < -50 && sb && sb.classList.contains('mob-open')) closeSb();
  }, {passive:true});

  // ── Drawer open/close ──
  function openDr() { mdr.classList.add('mob-open'); mdbd.classList.add('on'); }
  function closeDr() { mdr.classList.remove('mob-open'); mdbd.classList.remove('on'); }
  mdbd && mdbd.addEventListener('click', closeDr);

  // swipe down to close drawer
  var dy = 0;
  mdr && mdr.addEventListener('touchstart', function(e){ dy = e.touches[0].clientY; }, {passive:true});
  mdr && mdr.addEventListener('touchend', function(e){
    if(e.changedTouches[0].clientY - dy > 60) closeDr();
  }, {passive:true});

  // ── Auth state ──
  function setUser(user) {
    if (!mrt) return;
    if (user) {
      var name = user.displayName || user.email.split('@')[0];
      var av = name.charAt(0).toUpperCase();
      mrt.innerHTML = '<div class="_mav" id="_mavBtn">' + av + '</div>';
      document.getElementById('_mavBtn').addEventListener('click', function() {
        if (!mdc) return;
        mdc.innerHTML =
          '<div class="_mduser">' +
            '<div class="_mdav2">' + av + '</div>' +
            '<div><div style="font-size:0.92rem;font-weight:600;color:#e8ebf8;">' + name + '</div>' +
            '<div style="font-family:JetBrains Mono,monospace;font-size:0.54rem;color:rgba(255,255,255,0.3);margin-top:2px;">' + user.email + '</div></div>' +
          '</div>' +
          '<button class="_mdbtn blu" onclick="(typeof syncToCloud===\'function\'&&syncToCloud());closeDr();">' +
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M1 4V10H7M23 20V14H17M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>' +
            'Sync Now' +
          '</button>' +
          '<button class="_mdbtn red" onclick="firebase.auth().signOut().then(function(){localStorage.removeItem(\'buddy_storage_mode\');location.reload()});">' +
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>' +
            'Sign Out' +
          '</button>';
        openDr();
      });
    } else {
      mrt.innerHTML = '<button onclick="(typeof openOverlay===\'function\'?openOverlay():location.href=\'/\');if(typeof showScreen===\'function\')showScreen(\'screenStorage\');">SIGN IN</button>';
    }
  }

  if (typeof firebase !== 'undefined' && firebase.apps && firebase.apps.length) {
    firebase.auth().onAuthStateChanged(setUser);
  } else {
    setUser(null);
  }
})();
</script>

</body>
</html>
