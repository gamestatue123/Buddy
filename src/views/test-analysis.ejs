<div id="importGuideOverlay" style="display:none;position:fixed;inset:0;z-index:12000;background:rgba(4,6,14,0.9);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);align-items:center;justify-content:center;padding:1rem;">
