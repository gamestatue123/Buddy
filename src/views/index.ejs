<script src="/js/main.js"></script>
<script>
// ══ AUTH STATE ══
let _cu=null,_sm=null,_si=false,_al=false;
const CHAT_SECRET_STORAGE_KEY='buddy_secret_chat_code';
const CHAT_UNLOCK_DATE='1038-12-15';
const CHAT_UNLOCK_NAME='filter test infinity';
const CHAT_AUTO_INFTY_KEY='buddy_auto_enter_infinity';
let chatMode='public',chatUnsubs=[],chatMessages=[],chatPresence=[];
let chatReplyTo=null,chatEditingMessageId='',chatReactionTargetId='';
let gifApiKey='',gifConfigPromise=null,gifLastQuery='',gifSearchOffset=0,gifHasMore=false,gifSearchResults=[];
let secretInviteCode=localStorage.getItem(CHAT_SECRET_STORAGE_KEY)||'';
const chatGuestId=localStorage.getItem('buddy_chat_guest_id')||(`guest_${Math.random().toString(36).slice(2,10)}`);
localStorage.setItem('buddy_chat_guest_id',chatGuestId);

function _chatSafeGifUrl(value){
    try{const url=new URL(String(value||''));return url.protocol==='https:'&&/(^|\.)giphy\.com$/i.test(url.hostname)?url.href:'';}catch(e){return '';}
}
function _chatEsc(v){return (v==null?'':String(v)).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function _chatDisplayName(){return _cu?.displayName||_cu?.email?.split('@')[0]||'Anonymous';}
function _chatActorId(){return _cu?.uid||chatGuestId;}
function _chatActorName(){return _cu?.displayName||_cu?.email?.split('@')[0]||'Guest';}
function _fmtHM(ts){if(!ts)return '';const d=ts?.toDate?ts.toDate():new Date(ts);return d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});}
function _makeSecretCode(uid=''){const seed=`${uid||'local'}|${CHAT_UNLOCK_DATE}|${CHAT_UNLOCK_NAME}`;let h=2166136261;for(let i=0;i<seed.length;i++){h^=seed.charCodeAt(i);h+=((h<<1)+(h<<4)+(h<<7)+(h<<8)+(h<<24));}return `INF-${Math.abs(h>>>0).toString(36).toUpperCase().slice(0,8)}`;}
function isSecretUnlocked(){
    if(secretInviteCode)return true;
    try{
        const tests=JSON.parse(localStorage.getItem('test_analysis_data')||'[]');
        const ok=tests.some(t=>(t?.date||'')===CHAT_UNLOCK_DATE && ((t?.testName||t?.name||'').trim().toLowerCase()===CHAT_UNLOCK_NAME));
        if(ok){secretInviteCode=_makeSecretCode(_cu?.uid||'');localStorage.setItem(CHAT_SECRET_STORAGE_KEY,secretInviteCode);return true;}
    }catch(e){}
    return false;
}
function _chatRoomId(){
    if(chatMode!=='secret') return 'buddy-public';
    if(!isSecretUnlocked()) return '';
    return 'buddy-infinity-room';
}
function _clearChatSubs(){chatUnsubs.forEach(fn=>{try{fn();}catch(e){}});chatUnsubs=[];}
function _renderChatMessages(){
    const host=document.getElementById('buddyChatLog');if(!host)return;
    const nearBottom=host.scrollHeight-host.scrollTop-host.clientHeight<110;
    if(!chatMessages.length){host.innerHTML='<div class="chat-row"><div>No messages yet. Start the conversation 🚀</div></div>';return;}
    const actorId=_chatActorId();
    host.innerHTML=chatMessages.map(m=>{
        const mine=m.uid===actorId;
        const gifUrl=m.gif?_chatSafeGifUrl(m.gif):'';
        const reply=m.replyTo?'<div class="chat-reply-quote"><strong>'+_chatEsc(m.replyTo.name||'Reply')+'</strong><span>'+_chatEsc(m.replyTo.gif?'GIF':(m.replyTo.text||'Message'))+'</span></div>':'';
        const body=gifUrl?'<img class="chat-gif" src="'+_chatEsc(gifUrl)+'" alt="'+_chatEsc(m.gifTitle||'GIF')+'" loading="lazy" referrerpolicy="no-referrer">':'<div class="chat-message-body">'+_chatEsc(m.text||'')+'</div>';
        const actions='<div class="chat-message-actions"><button class="chat-action-btn" type="button" data-chat-action="reply" title="Reply" aria-label="Reply">↩</button><button class="chat-action-btn" type="button" data-chat-action="react" title="Add reaction" aria-label="Add reaction">☺</button><button class="chat-action-btn" type="button" data-chat-action="copy" title="Copy message" aria-label="Copy message">⧉</button>'+(mine?((m.gif?'':'<button class="chat-action-btn" type="button" data-chat-action="edit" title="Edit message" aria-label="Edit message">✎</button>')+'<button class="chat-action-btn" type="button" data-chat-action="delete" title="Delete message" aria-label="Delete message">×</button>'):'')+'</div>';
        let content=body;
        if(chatEditingMessageId===m.id&&mine){
            content='<div class="chat-edit-box"><textarea class="chat-edit-input" data-chat-edit-input maxlength="480">'+_chatEsc(m.text||'')+'</textarea><div class="chat-edit-actions"><button class="chat-action-btn" type="button" data-chat-action="cancel-edit">Cancel</button><button class="qa-btn primary" type="button" data-chat-action="save-edit">Save</button></div></div>';
        }else{
            content=reply+body;
        }
        const reactionEntries=Object.entries(m.reactions||{}).filter(entry=>Array.isArray(entry[1])&&entry[1].length);
        const reactions=reactionEntries.map(entry=>{
            const emoji=entry[0],users=entry[1],active=users.includes(actorId);
            return '<button class="chat-reaction'+(active?' active':'')+'" type="button" data-chat-action="react" data-emoji="'+_chatEsc(emoji)+'" aria-label="React with '+_chatEsc(emoji)+'">'+_chatEsc(emoji)+' <span>'+users.length+'</span></button>';
        }).join('');
        const edited=m.editedAt?'<span class="chat-edited">· edited</span>':'';
        return '<article class="chat-row '+(mine?'me':'')+'" data-message-id="'+_chatEsc(m.id)+'">'+actions+content+'<div class="chat-meta">'+_chatEsc(m.name||'Guest')+' · '+_fmtHM(m.createdAt)+edited+'</div>'+(reactions?'<div class="chat-reactions">'+reactions+'</div>':'')+'</article>';
    }).join('');
    if(nearBottom)host.scrollTop=host.scrollHeight;
}
async function _claimSecretSeat(){
    const roomId=_chatRoomId(); if(!roomId) return false;
    const actorId=_chatActorId();
    const db=firebase.firestore();
    const roomRef=db.collection('chatrooms').doc(roomId);
    try{
        const ok=await db.runTransaction(async tx=>{
            const snap=await tx.get(roomRef);
            const data=snap.exists?snap.data():{};
            const participants=Array.isArray(data.participants)?data.participants:[];
            if(!participants.includes(actorId) && participants.length>=2) return false;
            const next=participants.includes(actorId)?participants:[...participants,actorId];
            tx.set(roomRef,{type:'secret',code:secretInviteCode,participants:next,updatedAt:firebase.firestore.FieldValue.serverTimestamp()},{merge:true});
            tx.set(roomRef.collection('presence').doc(actorId),{uid:actorId,name:_chatActorName(),lastSeen:firebase.firestore.FieldValue.serverTimestamp()},{merge:true});
            return true;
        });
        return ok;
    }catch(e){return false;}
}
function _listenChatRoom(){
    const rid=_chatRoomId();
    const log=document.getElementById('buddyChatLog');
    if(!rid){if(log)log.innerHTML='<div class="chat-row">Room unavailable right now.</div>';return;}
    const db=firebase.firestore();
    const roomRef=db.collection('chatrooms').doc(rid);
    const msgQ=roomRef.collection('messages').orderBy('createdAt','asc').limitToLast(120);
    const pQ=roomRef.collection('presence').orderBy('lastSeen','desc').limit(10);
    chatUnsubs.push(msgQ.onSnapshot(snap=>{chatMessages=[];snap.forEach(d=>chatMessages.push({id:d.id,...d.data()}));_renderChatMessages();}));
    chatUnsubs.push(pQ.onSnapshot(snap=>{
        chatPresence=[];snap.forEach(d=>chatPresence.push(d.data()));
        const online=chatPresence.length;
        const isSecret=chatMode==='secret';
        document.getElementById('chatPresenceText').textContent=isSecret?`${online}/2 seats active`:`${online} online`;
        document.getElementById('publicCountPill') && (document.getElementById('publicCountPill').textContent=String(online));
    }));
}
async function refreshBuddyChatRoom(){
    _clearChatSubs();
    chatMessages=[];_renderChatMessages();
    const system=document.getElementById('chatSystemText');
    const unlocked=isSecretUnlocked();
    if(chatMode==='secret'){
        if(!unlocked){closeBuddyChatRoom();return;}
        const ok=await _claimSecretSeat();
        if(!ok){if(system)system.textContent='Room is full (2/2). Try later.';document.getElementById('buddyChatLog').innerHTML='<div class="chat-row">⚠️ This room is currently full.</div>';return;}
    }
    if(system)system.textContent=chatMode==='secret'?'Private room active.':'Public room open to everyone.';
    _listenChatRoom();
}
function switchBuddyRoom(mode){
    const nextMode=mode==='secret'?'secret':'public';
    if(nextMode!==chatMode){_releaseSecretSeat();chatEditingMessageId='';clearChatReply();closeChatPopups();}
    chatMode=nextMode;
    document.getElementById('chatPublicBtn')?.classList.toggle('active',chatMode==='public');
    document.getElementById('chatRoomTitle').textContent=chatMode==='secret'?'PRIVATE ROOM':'PUBLIC CHAT';
    document.getElementById('chatRoomSubtitle').textContent=chatMode==='secret'?'Realtime room · 2 concurrent users max.':'Discuss prep, ask doubts, motivate each other.';
    refreshBuddyChatRoom();
}
function openBuddyChatRoom(){document.getElementById('buddyChatModal')?.classList.add('open');switchBuddyRoom('public');}
function openInfinityRoomSilently(){document.getElementById('buddyChatModal')?.classList.add('open');switchBuddyRoom('secret');}
function _releaseSecretSeat(){
    if(chatMode!=='secret') return;
    const rid=_chatRoomId(); if(!rid) return;
    const roomRef=firebase.firestore().collection('chatrooms').doc(rid);
    roomRef.collection('presence').doc(_chatActorId()).delete().catch(()=>{});
}
function closeBuddyChatRoom(){_releaseSecretSeat();_clearChatSubs();chatEditingMessageId='';clearChatReply();closeChatPopups();document.getElementById('buddyChatModal')?.classList.remove('open');}
async function sendBuddyChatMessage(){
    const input=document.getElementById('buddyChatInput');
    const text=input?.value?.trim();if(!text)return;
    if(chatMode==='secret'&&!isSecretUnlocked()){showToastMsg('Unlock secret room first');return;}
    const rid=_chatRoomId();if(!rid)return;
    const payload={text:text.slice(0,480),uid:_chatActorId(),name:_chatActorName(),createdAt:firebase.firestore.FieldValue.serverTimestamp()};
    if(chatReplyTo)payload.replyTo={id:chatReplyTo.id,name:chatReplyTo.name,text:(chatReplyTo.text||'').slice(0,240),gif:Boolean(chatReplyTo.gif)};
    try{
        await firebase.firestore().collection('chatrooms').doc(rid).collection('messages').add(payload);
        input.value='';_resizeChatInput(input);clearChatReply();closeChatPopups();input.focus();
    }catch(e){showToastMsg('Could not send message');}
}
async function editChatMessage(id){
    const m=chatMessages.find(x=>x.id===id);
    if(!m||m.uid!==_chatActorId())return;
    const input=document.querySelector('[data-chat-edit-input]');
    const text=input?.value?.trim();if(!text)return;
    try{
        await firebase.firestore().collection('chatrooms').doc(_chatRoomId()).collection('messages').doc(id).update({text:text.slice(0,480),editedAt:firebase.firestore.FieldValue.serverTimestamp()});
        chatEditingMessageId='';
    }catch(e){showToastMsg('Could not edit message');}
}
async function deleteChatMessage(id){
    const m=chatMessages.find(x=>x.id===id);
    if(!m||m.uid!==_chatActorId())return;
    if(!window.confirm('Delete this message?'))return;
    try{
        await firebase.firestore().collection('chatrooms').doc(_chatRoomId()).collection('messages').doc(id).delete();
    }catch(e){showToastMsg('Could not delete message');}
}
async function toggleChatReaction(id,emoji){
    if(!id||!emoji)return;
    const uid=_chatActorId();
    const ref=firebase.firestore().collection('chatrooms').doc(_chatRoomId()).collection('messages').doc(id);
    try{
        await firebase.firestore().runTransaction(async tx=>{
            const snap=await tx.get(ref);if(!snap.exists)return;
            const data=snap.data()||{},reactions={...(data.reactions||{})};
            const users=Array.isArray(reactions[emoji])?[...reactions[emoji]]:[];
            const index=users.indexOf(uid);
            if(index>=0)users.splice(index,1);else users.push(uid);
            if(users.length)reactions[emoji]=users;else delete reactions[emoji];
            tx.update(ref,{reactions});
        });
    }catch(e){showToastMsg('Could not add reaction');}
}
function _resizeChatInput(input){
    if(!input)return;
    input.style.height='auto';
    input.style.height=Math.min(input.scrollHeight,132)+'px';
}
function _setChatReply(m){
    if(!m)return;
    chatReplyTo={id:m.id,name:m.name||'Guest',text:m.text||'',gif:m.gif||''};
    document.getElementById('chatReplyName').textContent='Replying to '+chatReplyTo.name;
    document.getElementById('chatReplyText').textContent=chatReplyTo.gif?'GIF':chatReplyTo.text;
    document.getElementById('chatReplyPreview').hidden=false;
    document.getElementById('buddyChatInput')?.focus();
}
function clearChatReply(){
    chatReplyTo=null;
    const preview=document.getElementById('chatReplyPreview');if(preview)preview.hidden=true;
}
function closeChatPopups(){
    document.getElementById('emojiPopup')?.classList.remove('show');
    document.getElementById('gifPopup')?.classList.remove('show');
    document.getElementById('chatEmojiButton')?.setAttribute('aria-expanded','false');
    document.getElementById('chatGifButton')?.setAttribute('aria-expanded','false');
    chatReactionTargetId='';
}
function initChatLauncher(){
    const modal=document.getElementById('buddyChatModal');
    modal?.addEventListener('click',e=>{if(e.target.id==='buddyChatModal')closeBuddyChatRoom();});
    const input=document.getElementById('buddyChatInput');
    input?.addEventListener('keydown',e=>{
        if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();sendBuddyChatMessage();}
    });
    input?.addEventListener('input',()=>_resizeChatInput(input));
    const log=document.getElementById('buddyChatLog');
    log?.addEventListener('click',async e=>{
        const button=e.target.closest('[data-chat-action]');
        const row=e.target.closest('[data-message-id]');
        if(!button||!row)return;
        const id=row.dataset.messageId,m=chatMessages.find(x=>x.id===id),action=button.dataset.chatAction;
        if(!m)return;
        if(action==='reply')_setChatReply(m);
        else if(action==='copy'){
            const value=m.text||m.gif||'';
            try{await navigator.clipboard.writeText(value);showToastMsg('Copied');}catch(err){showToastMsg('Copy unavailable');}
        }else if(action==='edit'){chatEditingMessageId=id;_renderChatMessages();const edit=document.querySelector('[data-chat-edit-input]');edit?.focus();edit?.select();}
        else if(action==='delete')deleteChatMessage(id);
        else if(action==='cancel-edit'){chatEditingMessageId='';_renderChatMessages();}
        else if(action==='save-edit')editChatMessage(id);
        else if(action==='react'){
            const emoji=button.dataset.emoji;
            if(emoji)toggleChatReaction(id,emoji);
            else{toggleEmojiPicker(id);}
        }
    });
    const results=document.getElementById('gifResults');
    results?.addEventListener('click',e=>{
        const card=e.target.closest('[data-send-gif]');
        if(card)sendGifMessage(card.dataset.gifUrl,card.dataset.gifId,card.dataset.gifTitle);
        else if(e.target.closest('[data-gif-more]'))searchGifs(true);
    });
    document.getElementById('gifSearchInput')?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();searchGifs();}});
    initEmojiPicker();
    window.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal?.classList.contains('open')){if(document.querySelector('.chat-popup.show'))closeChatPopups();else closeBuddyChatRoom();}});
    window.addEventListener('beforeunload',_releaseSecretSeat);
    if(!secretInviteCode&&_cu?.uid){secretInviteCode=_makeSecretCode(_cu.uid);localStorage.setItem(CHAT_SECRET_STORAGE_KEY,secretInviteCode);}
    const qp=new URLSearchParams(location.search);
    const auto=qp.get('chat')==='infinity'||localStorage.getItem(CHAT_AUTO_INFTY_KEY)==='1';
    if(auto&&isSecretUnlocked()){
        localStorage.removeItem(CHAT_AUTO_INFTY_KEY);
        setTimeout(()=>openInfinityRoomSilently(),120);
        if(qp.get('chat')==='infinity'){const url=new URL(location.href);url.searchParams.delete('chat');history.replaceState({},'',url.pathname+url.search+url.hash);}
    }
}
function toggleEmojiPicker(reactionMessageId=''){
    const popup=document.getElementById('emojiPopup'),wasOpen=popup?.classList.contains('show'),currentTarget=chatReactionTargetId;
    const open=reactionMessageId?(!wasOpen||currentTarget!==reactionMessageId):!wasOpen;
    closeChatPopups();if(open){popup?.classList.add('show');chatReactionTargetId=reactionMessageId||'';}
    document.getElementById('chatEmojiButton')?.setAttribute('aria-expanded',String(open));
}
function toggleGifPicker(){
