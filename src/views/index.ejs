// DPP
function loadDPPStats(){
    let allQ=[];try{const p=JSON.parse(localStorage.getItem('dpp_q2')||localStorage.getItem('dpp_questions')||'{}');allQ=[...(p['11']||[]),...(p['12']||[])];}catch(e){}
    const elTotal=document.getElementById('dppTotal'),elGood=document.getElementById('dppGood'),elTricky=document.getElementById('dppTricky'),elTough=document.getElementById('dppTough'),elCore=document.getElementById('dppCore'),elStat=document.getElementById('statDppCount');
    if(elTotal)elTotal.textContent=allQ.length;
    if(elGood)elGood.textContent=allQ.filter(q=>q.status==='good').length;
    if(elTricky)elTricky.textContent=allQ.filter(q=>q.status==='tricky').length;
    if(elTough)elTough.textContent=allQ.filter(q=>q.status==='tough').length;
    if(elCore)elCore.textContent=allQ.filter(q=>q.status==='fundamental').length;
    if(elStat)elStat.textContent=allQ.length;
    const SMAP={'Mathematics':['Basic Maths (Mod & Log)','Quadratic Equations','Trigonometry','Progression & Series','Binomial Theorem','Straight Lines','Permutation & Combination','Set Theory','Statistics'],'Physics':['Centre of Mass','Work Power Energy','Kinematics','Units & Dimensions','Rotational Motion','Fluid & Elasticity','SHM'],'Chemistry':['Concentration Terms & Eudiometry','Atomic Structure','Periodic Table','IUPAC Nomenclature','Chemical Equilibrium','Ionic Equilibrium','Ideal Gas','Chemical Bonding','Redox Reactions','Stereoisomers']};
    const bySub={Mathematics:0,Physics:0,Chemistry:0};
    allQ.forEach(q=>{for(const[s,cs]of Object.entries(SMAP)){if(cs.includes(q.chapter)){bySub[s]++;break;}}});
    const maxS=Math.max(...Object.values(bySub),1),cols={Mathematics:'var(--math)',Physics:'var(--phys)',Chemistry:'var(--chem)'};
    const elSubj=document.getElementById('subjBars');
    if(elSubj)elSubj.innerHTML=Object.entries(bySub).map(([s,n])=>`<div class="subj-row"><div class="subj-row-top"><div class="subj-name" style="color:${cols[s]}">${s}</div><div class="subj-pct">${n} Q</div></div><div class="subj-track"><div class="subj-fill" style="width:${Math.round(n/maxS*100)}%;background:${cols[s]}"></div></div></div>`).join('');
    const byChap={};allQ.forEach(q=>{byChap[q.chapter]=(byChap[q.chapter]||0)+1;});
    const top5=Object.entries(byChap).sort((a,b)=>b[1]-a[1]).slice(0,5),maxC=top5[0]?.[1]||1;
    const elBreakdown=document.getElementById('dppBreakdown');
    if(elBreakdown)elBreakdown.innerHTML=top5.map(([ch,n])=>{
        const t=allQ.filter(q=>q.chapter===ch&&(q.status==='tough'||q.status==='tricky')).length;
        return`<div style="display:flex;align-items:center;gap:8px"><div style="font-size:0.75rem;width:130px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--fg2)">${esc(ch.substring(0,18))}</div><div style="flex:1;height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden"><div style="width:${Math.round(n/maxC*100)}%;height:100%;background:linear-gradient(90deg,var(--acc),var(--acc2));border-radius:2px;"></div></div><div style="font-family:var(--fm);font-size:0.62rem;color:var(--fg3);width:28px;text-align:right">${n}</div>${t>0?`<div style="font-family:var(--fm);font-size:0.56rem;color:var(--red)">⚠${t}</div>`:'<div style="width:20px"></div>'}</div>`;
    }).join('')||'<div style="font-family:var(--fm);font-size:0.7rem;color:var(--fg3);padding:1rem">No DPPs logged yet</div>';
}

