<div class="toast-el" id="ttToast"></div>
<div id="toast" class="toast"></div>
<script src="/js/main.js"></script>
<script>
// ══ AUTH STATE ══
let _cu=null,_sm=null,_si=false,_al=false;

function showScreen(id){document.querySelectorAll('.auth-screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');}
function closeOverlay(){document.getElementById('authOverlay').classList.remove('show');}
function openOverlay(){document.getElementById('authOverlay').classList.add('show');}

function ensureAuthListener(){
    if(_al)return; _al=true;
    firebase.auth().onAuthStateChanged(async user=>{
        if(user){
            _cu=user; _sm='cloud';
            localStorage.setItem('buddy_storage_mode','cloud');
            showUserPill(user);
            document.getElementById('syncStatusText').textContent='CLOUD ✓';
            await syncFromCloud();
            closeOverlay();
            loadPageData();
            const lb=document.getElementById('loginBtn'),sb=document.getElementById('signupBtn');
            if(lb){lb.innerHTML='SIGN IN';lb.disabled=false;}
            if(sb){sb.innerHTML='CREATE ACCOUNT';sb.disabled=false;}
        }
    });
}

window.addEventListener('DOMContentLoaded',()=>{
    ensureAuthListener();
    const mode=localStorage.getItem('buddy_storage_mode');
    if(!mode){setTimeout(()=>openOverlay(),140);}
    else if(mode==='local'){_sm='local';loadLocalData();}
    else{_sm='cloud';setTimeout(()=>{if(!_cu){openOverlay();showScreen('screenLogin');}},1600);}
});

function selectStorage(mode){
    _sm=mode; localStorage.setItem('buddy_storage_mode',mode);
    if(mode==='local'){let p={};try{p=JSON.parse(localStorage.getItem('buddy_profile')||'{}');}catch(e){};if(!p.targetYear){const y=prompt('Enter your target JEE year (e.g. 2027):','2027');if(!y){showToastMsg('Target year is required for setup.');return;}p.targetYear=Number(y)||2027;localStorage.setItem('buddy_profile',JSON.stringify(p));}closeOverlay();loadLocalData();}
    else{ensureAuthListener();if(!firebase.auth().currentUser)showScreen('screenLogin');}
}

async function doLogin(){
    const e=document.getElementById('loginEmail').value.trim(),p=document.getElementById('loginPassword').value;
    const err=document.getElementById('loginError'),btn=document.getElementById('loginBtn');
    if(!e||!p){showAuthErr(err,'Enter your email and password.');return;}
    err.classList.remove('show');btn.innerHTML='<span class="auth-spinner"></span>SIGNING IN...';btn.disabled=true;
    try{await firebase.auth().signInWithEmailAndPassword(e,p);}
    catch(ex){showAuthErr(err,friendlyErr(ex.code));btn.innerHTML='SIGN IN';btn.disabled=false;}
}

async function doSignup(){
    const n=document.getElementById('signupName').value.trim(),cls=document.getElementById('signupClass').value,targetYear=document.getElementById('signupTargetYear').value.trim(),batch=document.getElementById('signupBatch').value.trim(),e=document.getElementById('signupEmail').value.trim(),p=document.getElementById('signupPassword').value,c=document.getElementById('signupConfirm').value;
    const err=document.getElementById('signupError'),btn=document.getElementById('signupBtn');
    if(!n||!e||!p||!targetYear){showAuthErr(err,'Name, target year, email and password are required.');return;}
    if(p!==c){showAuthErr(err,'Passwords do not match.');return;}
    if(p.length<6){showAuthErr(err,'Password must be at least 6 characters.');return;}
    err.classList.remove('show');btn.innerHTML='<span class="auth-spinner"></span>CREATING...';btn.disabled=true;
    try{
        const cred=await firebase.auth().createUserWithEmailAndPassword(e,p);
        await cred.user.updateProfile({displayName:n});
        const profile={name:n,classLevel:cls,targetYear:Number(targetYear),batch:batch||'Self-study',email:e,createdAt:new Date().toISOString()};localStorage.setItem('buddy_profile',JSON.stringify(profile));firebase.firestore().collection('users').doc(cred.user.uid).set(profile).catch(()=>{});
        await cred.user.sendEmailVerification();
        document.getElementById('verifyEmailDisplay').textContent=e;
        showScreen('screenVerify');
        btn.innerHTML='CREATE ACCOUNT';btn.disabled=false;
    }catch(ex){showAuthErr(err,friendlyErr(ex.code));btn.innerHTML='CREATE ACCOUNT';btn.disabled=false;}
}

async function checkVerification(){
    const btn=document.getElementById('verifyBtn');
    btn.innerHTML='<span class="auth-spinner"></span>CHECKING...';btn.disabled=true;
    await firebase.auth().currentUser?.reload();
    if(firebase.auth().currentUser?.emailVerified){closeOverlay();loadPageData();}
    else{btn.innerHTML="I'VE VERIFIED — CONTINUE";btn.disabled=false;showToastMsg('⚠️ Not verified yet. Check your inbox.');}
}
async function resendVerification(){
    try{await firebase.auth().currentUser?.sendEmailVerification();showToastMsg('📬 Verification email resent!');}
    catch(e){showToastMsg('Too many requests — wait a minute.');}
}

async function signInWithGoogle(){
    try{const p=new firebase.auth.GoogleAuthProvider();await firebase.auth().signInWithPopup(p);localStorage.setItem('buddy_storage_mode','cloud');}
    catch(e){if(e.code!=='auth/popup-closed-by-user')showToastMsg(friendlyErr(e.code));}
}
async function signInWithMicrosoft(){
    try{const p=new firebase.auth.OAuthProvider('microsoft.com');p.setCustomParameters({prompt:'select_account'});await firebase.auth().signInWithPopup(p);localStorage.setItem('buddy_storage_mode','cloud');}
    catch(e){if(e.code!=='auth/popup-closed-by-user')showToastMsg(friendlyErr(e.code));}
}
async function doLogout(){
    try{await firebase.auth().signOut();}catch(e){}
    localStorage.removeItem('buddy_storage_mode');location.reload();
}

function showUserPill(user){
    const pill=document.getElementById('userMenuPill');
    const localBtn=document.getElementById('localSignInBtn');
    const name=user.displayName||user.email.split('@')[0];
    document.getElementById('userName').textContent=name;
    document.getElementById('userEmail').textContent=user.email;
    document.getElementById('userAvatar').textContent=name.charAt(0).toUpperCase();
    pill.style.display='flex';
    if(localBtn) localBtn.style.display='none';
    const hn=document.getElementById('heroName');
    hn.textContent=name.split(' ')[0].toUpperCase()+',';
    hn.style.display='block';
    applyProfile({name:user.displayName||name});
}
function showLocalSignInButton(){
    const pill=document.getElementById('userMenuPill');
    const localBtn=document.getElementById('localSignInBtn');
    if(pill) pill.style.display='none';
    if(localBtn) localBtn.style.display='flex';
}
}
function toggleUserDropdown(){document.getElementById('userDropdown').classList.toggle('show');}
document.addEventListener('click',e=>{if(!e.target.closest('#userMenuPill'))document.getElementById('userDropdown')?.classList.remove('show');});
function showAuthErr(el,msg){el.textContent=msg;el.classList.add('show');}
function friendlyErr(c){return({'auth/user-not-found':'No account found.','auth/wrong-password':'Wrong password.','auth/invalid-email':'Invalid email address.','auth/email-already-in-use':'Email already registered.','auth/too-many-requests':'Too many attempts — wait a moment.','auth/invalid-credential':'Invalid email or password.','auth/popup-blocked':'Allow popups for this site.'})[c]||'Something went wrong.';}
// ========== WIDGET DATA LOADER ==========
window.refreshWidgets = function() {
    loadSyllabusStats();
    loadRecentTests();
    loadUpcomingTasks();
};

function loadSyllabusStats() {
    // Try cloud data first, fallback to localStorage
    const syllabusData = JSON.parse(localStorage.getItem('buddy_syllabus') || '{}');
    const totalTopics = Object.keys(syllabusData).length;
    const completed = Object.values(syllabusData).filter(t => t.completed === true).length;
    const progress = totalTopics ? Math.round((completed / totalTopics) * 100) : 0;
    
    updateWidget('syllabus-progress', progress);
    updateWidget('syllabus-completed', `${completed}/${totalTopics}`);
}

function loadRecentTests() {
    const tests = JSON.parse(localStorage.getItem('buddy_tests') || '[]');
    const recentTests = tests.slice(0, 3);
    
    const container = document.getElementById('recent-tests-list');
    if (container) {
        if (recentTests.length === 0) {
            container.innerHTML = '<div class="empty-state">No tests yet. Start practicing!</div>';
        } else {
            container.innerHTML = recentTests.map(test => `
                <div class="test-item">
                    <span class="test-name">${test.name || 'Practice Test'}</span>
                    <span class="test-score" style="color: ${test.score >= 70 ? 'var(--grn)' : 'var(--amber)'}">
                        ${test.score}%
                    </span>
                </div>
            `).join('');
        }
    }
}

function loadUpcomingTasks() {
    const timetable = JSON.parse(localStorage.getItem('buddy_timetable') || '[]');
    const today = new Date().toISOString().split('T')[0];
    const upcoming = timetable.filter(item => item.date >= today).slice(0, 4);
    
    const container = document.getElementById('upcoming-tasks');
    if (container) {
        if (upcoming.length === 0) {
            container.innerHTML = '<div class="empty-state">No upcoming tasks. Add to your timetable!</div>';
        } else {
            container.innerHTML = upcoming.map(task => `
                <div class="task-item">
                    <span class="task-time">${task.time || 'Flexible'}</span>
                    <span class="task-subject">${task.subject || 'Study'}</span>
                    <span class="task-topic">${task.topic || 'Review'}</span>
                </div>
            `).join('');
        }
    }
}

function updateWidget(widgetId, value) {
    const el = document.getElementById(widgetId);
    if (el) el.textContent = value;
}

// Initialize widgets on page load
document.addEventListener('DOMContentLoaded', () => {
    loadSyllabusStats();
    loadRecentTests();
    loadUpcomingTasks();
});
// ══ SYNC ══
async function syncFromCloud(){
    if(!_cu)return;
    const uid=_cu.uid;
    try{
        const snap=await firebase.firestore().collection('users').doc(uid).collection('tests').get();
        const tests=[];snap.forEach(d=>tests.push(d.data()));
        if(tests.length)localStorage.setItem('test_analysis_data',JSON.stringify(tests));
        const qSnap=await firebase.firestore().collection('users').doc(uid).collection('tasks').get();
        const tasks=[];qSnap.forEach(d=>tasks.push(d.data()));
        if(tasks.length)localStorage.setItem('dpp_questions',JSON.stringify({'11':tasks,'12':[]}));
        const sylSnap=await firebase.firestore().collection('users').doc(uid).collection('syllabus').get();
        const syl={};sylSnap.forEach(d=>syl[d.id]=d.data());
        if(Object.keys(syl).length)localStorage.setItem('syllabus_progress',JSON.stringify(syl));
    }catch(e){console.warn('syncFromCloud failed',e);}
}
async function syncToCloud(){
    if(!_cu||_sm!=='cloud'||_si)return; _si=true;
    document.getElementById('syncStatusText').textContent='⟳ SYNCING';
    try{
        const uid=_cu.uid,raw=localStorage.getItem('test_analysis_data');
        if(raw){const tests=JSON.parse(raw);const ref=firebase.firestore().collection('users').doc(uid).collection('tests');const old=await ref.get();old.forEach(d=>d.ref.delete());for(const t of tests)await ref.add(t);}
        document.getElementById('syncStatusText').textContent='CLOUD ✓';
        setTimeout(()=>{try{document.getElementById('syncStatusText').textContent='CLOUD ✓';}catch(e){}},2500);
    }catch(e){document.getElementById('syncStatusText').textContent='⚠ FAILED';}
    finally{_si=false;}
}
function loadLocalData(){showLocalSignInButton();document.getElementById('syncStatusText').textContent='LOCAL';applyProfile();loadPageData();}

// ══ PAGE DATA ══
function applyProfile(override={}){
    let profile={};
    try{profile=JSON.parse(localStorage.getItem('buddy_profile')||'{}');}catch(e){}
    profile={...profile,...override};
    const cls=(profile.classLevel||'11').toString().toUpperCase();
    const target=profile.targetYear||2027;
    const batch=profile.batch||'Self-study';
    const name=profile.name||'';
    const eb=document.getElementById('heroEyebrow');
    if(eb) eb.textContent=`JEE ${target} · CLASS ${cls} · ${batch.toUpperCase()}`;
    const hn=document.getElementById('heroName');
    if(name&&hn){hn.textContent=name.split(' ')[0].toUpperCase()+',';hn.style.display='block';}
}
function loadPageData(){applyProfile();loadDPPStats();loadSyllabusProgress();loadMomentumWidget();loadTasks();loadScheduleLocal();loadStreak();loadTestWidget();updateCountdown();}

// Clock
function updateClock(){
    const now=new Date();
    document.getElementById('clockTime').textContent=`${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
    const D=['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'],M=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
    document.getElementById('clockDate').textContent=`${D[now.getDay()].slice(0,3)} ${String(now.getDate()).padStart(2,'0')} ${M[now.getMonth()]}`;
    document.getElementById('clockDay').textContent=D[now.getDay()];
    const h=now.getHours();document.getElementById('heroGreeting').textContent=h<5?'GOOD NIGHT':h<12?'GOOD MORNING':h<17?'GOOD AFTERNOON':'GOOD EVENING';
}
setInterval(updateClock,1000);updateClock();

// Countdown
function updateCountdown(){
    const plan=JSON.parse(localStorage.getItem('active_test_plan')||'{}');const exam=new Date((plan.examDate||'2027-01-20')+'T09:00:00'),start=new Date('2025-06-01'),now=new Date(),rem=exam-now;document.querySelector('.cd-exam').textContent=(plan.examName||'JEE MAINS 2027').toUpperCase();
    if(rem<=0){document.getElementById('cdDays').textContent='GO!';return;}
    const d=Math.floor(rem/86400000);
    document.getElementById('cdDays').textContent=d;
    document.getElementById('cdWeeks').textContent=Math.floor(d/7);
    document.getElementById('cdMonths').textContent=Math.floor(d/30.44);
    document.getElementById('cdHours').textContent=Math.min(Math.floor(rem/3600000),9999);
    const pct=Math.max(0,Math.min(1,1-rem/(exam-start)));
    document.getElementById('cdRingFill').style.strokeDashoffset=232.48-pct*232.48;
    document.getElementById('cdPct').textContent=Math.round(pct*100)+'%';
}
setInterval(updateCountdown,60000);updateCountdown();

// Ticker
const TICKER=[{t:'JEE 2027',v:'TARGET LOCKED'},{t:'PHYSICS · CHEMISTRY · MATHS',v:'⚡'},{t:'EVERY QUESTION',v:'MATTERS'},{t:'CONSISTENCY',v:'BEATS INTENSITY'},{t:'TRACK YOUR DPP',v:'LOG TODAY'},{t:'SYLLABUS MASTERY',v:'BUILD IT DAILY'},{t:'RANK',v:'IS EARNED NOT GIVEN'}];
(()=>{const d=[...TICKER,...TICKER];document.getElementById('tickerTrack').innerHTML=d.map(i=>`<div class="ticker-item">${i.t} <span>${i.v}</span></div>`).join('');})();

// Quotes
const QUOTES=["The exam doesn't know how hard you've worked. It only knows your answer.","You didn't come this far to only come this far.","Every chapter you master is one less thing between you and your rank.","Right now, somewhere, your competition is taking a break. Keep going.","Hard questions are just easy questions you haven't solved enough times yet.","Your brain is a muscle. DPP is the gym. Skip neither.","JEE is not a test of intelligence — it's a test of preparation.","Stop waiting for motivation. Start building discipline.","The only bad session is the one you skipped.","Your rank in JEE is directly proportional to the number of problems you've solved."];
let qIdx=Math.floor(Math.random()*QUOTES.length);
function setQuote(){document.getElementById('dailyQuote').textContent='"'+QUOTES[qIdx]+'"';qIdx=(qIdx+1)%QUOTES.length;}
setQuote();
document.getElementById('refreshQuote').addEventListener('click',setQuote);

function esc(s){if(!s)return'';return s.replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function showToastMsg(m){const t=document.getElementById('ttToast');t.textContent=m;t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),2600);}
window.showComingSoon=(e)=>{if(e)e.preventDefault();showToastMsg('✨ Feature coming soon!');};

// Schedule from localStorage
function loadScheduleLocal(){
    try{
        const DAYKEYS=['mon','tue','wed','thu','fri','sat','sun'];
        const DAYNAMES=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
        const SUB_COLORS={Physics:'var(--phys)',Chemistry:'var(--chem)',Mathematics:'var(--math)',Maths:'var(--math)'};
        const dayIdx=(new Date().getDay()+6)%7;
        const dayKey=DAYKEYS[dayIdx];
        document.getElementById('classDayBadge').textContent=DAYNAMES[dayIdx].toUpperCase();
        const sched=JSON.parse(localStorage.getItem('buddy_schedule')||'{}');
        const cls=(sched[dayKey]||[]).filter(c=>c.subject&&c.subject!=='Off');
        if(!cls.length){document.getElementById('scheduleList').innerHTML=`<div class="empty-card"><div class="empty-ico">🏖</div><div class="empty-t">No classes today</div></div>`;return;}
        document.getElementById('scheduleList').innerHTML=cls.map(c=>`<div class="sch-item"><div class="sch-dot" style="background:${SUB_COLORS[c.subject]||'var(--acc)'}"></div><div class="sch-text">${esc(c.subject)}</div>${c.time?`<div class="sch-tag">${esc(c.time)}</div>`:''}${c.teacher?`<div class="sch-tag">· ${esc(c.teacher)}</div>`:''}</div>`).join('');
    }catch(e){}
}

// Streak from localStorage
function loadStreak(){
    try{
        const streak=parseInt(localStorage.getItem('buddy_streak')||'0');
        document.getElementById('streakNum').textContent=streak;
        const hse=document.getElementById('homeStreak');
        if(hse) hse.textContent='Streak: '+streak+' days';
    }catch(e){}
}
// Momentum widget
function loadMomentumWidget(){
    const box=document.getElementById('momentumWidget');
    const list=document.getElementById('momentumChecklist');
    if(!box||!list)return;
    let q=[];try{const p=JSON.parse(localStorage.getItem('dpp_q2')||localStorage.getItem('dpp_questions')||'{}');q=[...(p['11']||[]),...(p['12']||[])];}catch(e){}
    let tests=[];try{tests=JSON.parse(localStorage.getItem('test_analysis_data')||'[]');}catch(e){}
    const today=new Date().toISOString().slice(0,10);
    const todayQs=q.filter(x=>(x.createdAt||'').slice(0,10)===today).length;
    const lastTest=[...tests].sort((a,b)=>new Date(b.date||0)-new Date(a.date||0))[0];
    const testScore=lastTest?((lastTest.total ?? lastTest.totalMarks ?? ((lastTest.physics||0)+(lastTest.chemistry||0)+(lastTest.maths||0)))):0;
    box.innerHTML=`<div class="mini-card"><div class="mini-card-n" style="color:var(--amber)">${todayQs}</div><div class="mini-card-l">Questions Today</div></div><div class="mini-card"><div class="mini-card-n" style="color:var(--vio)">${tests.length}</div><div class="mini-card-l">Mocks Logged</div></div><div class="mini-card"><div class="mini-card-n" style="color:var(--grn)">${testScore}</div><div class="mini-card-l">Latest Test Score</div></div>`;
    const plan=JSON.parse(localStorage.getItem('active_test_plan')||'{}');
    const todo=[
      {ok:todayQs>=30,t:'Solve 30+ questions today'},
      {ok:tests.length>0,t:'Review latest mock mistakes'},
      {ok:(plan.revisionTarget||0)>=70,t:'Revision target set to 70%+'},
      {ok:!!(plan.examDate),t:'Exam countdown configured'}
    ];
    list.innerHTML=todo.map(i=>`<div class="task-row"><div class="task-cb" style="border-color:${i.ok?'var(--grn)':'var(--fg3)'};background:${i.ok?'var(--grn)':'transparent'}"></div><div class="task-text">${i.t}</div></div>`).join('');
    const done=todo.filter(i=>i.ok).length;
    document.getElementById('momentumBadge').textContent=`${done}/${todo.length} READY`;
}

// DPP
function loadDPPStats(){
    let allQ=[];try{const p=JSON.parse(localStorage.getItem('dpp_q2')||localStorage.getItem('dpp_questions')||'{}');allQ=[...(p['11']||[]),...(p['12']||[])];}catch(e){}
    document.getElementById('dppTotal').textContent=allQ.length;
    document.getElementById('dppGood').textContent=allQ.filter(q=>q.status==='good').length;
    document.getElementById('dppTricky').textContent=allQ.filter(q=>q.status==='tricky').length;
    document.getElementById('dppTough').textContent=allQ.filter(q=>q.status==='tough').length;
    document.getElementById('dppCore').textContent=allQ.filter(q=>q.status==='fundamental').length;
    document.getElementById('statDppCount').textContent=allQ.length;
    const SMAP={'Mathematics':['Basic Maths (Mod & Log)','Quadratic Equations','Trigonometry','Progression & Series','Binomial Theorem','Straight Lines','Permutation & Combination','Set Theory','Statistics'],'Physics':['Centre of Mass','Work Power Energy','Kinematics','Units & Dimensions','Rotational Motion','Fluid & Elasticity','SHM'],'Chemistry':['Concentration Terms & Eudiometry','Atomic Structure','Periodic Table','IUPAC Nomenclature','Chemical Equilibrium','Ionic Equilibrium','Ideal Gas','Chemical Bonding','Redox Reactions','Stereoisomers']};
    const bySub={Mathematics:0,Physics:0,Chemistry:0};
    allQ.forEach(q=>{for(const[s,cs]of Object.entries(SMAP)){if(cs.includes(q.chapter)){bySub[s]++;break;}}});
    const maxS=Math.max(...Object.values(bySub),1),cols={Mathematics:'var(--math)',Physics:'var(--phys)',Chemistry:'var(--chem)'};
    document.getElementById('subjBars').innerHTML=Object.entries(bySub).map(([s,n])=>`<div class="subj-row"><div class="subj-row-top"><div class="subj-name" style="color:${cols[s]}">${s}</div><div class="subj-pct">${n} Q</div></div><div class="subj-track"><div class="subj-fill" style="width:${Math.round(n/maxS*100)}%;background:${cols[s]}"></div></div></div>`).join('');
    const byChap={};allQ.forEach(q=>{byChap[q.chapter]=(byChap[q.chapter]||0)+1;});
    const top5=Object.entries(byChap).sort((a,b)=>b[1]-a[1]).slice(0,5),maxC=top5[0]?.[1]||1;
    document.getElementById('dppBreakdown').innerHTML=top5.map(([ch,n])=>{
        const t=allQ.filter(q=>q.chapter===ch&&(q.status==='tough'||q.status==='tricky')).length;
        return`<div style="display:flex;align-items:center;gap:8px"><div style="font-size:0.75rem;width:130px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--fg2)">${esc(ch.substring(0,18))}</div><div style="flex:1;height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden"><div style="width:${Math.round(n/maxC*100)}%;height:100%;background:linear-gradient(90deg,var(--acc),var(--acc2));border-radius:2px;"></div></div><div style="font-family:var(--fm);font-size:0.62rem;color:var(--fg3);width:28px;text-align:right">${n}</div>${t>0?`<div style="font-family:var(--fm);font-size:0.56rem;color:var(--red)">⚠${t}</div>`:'<div style="width:20px"></div>'}</div>`;
    }).join('')||'<div style="font-family:var(--fm);font-size:0.7rem;color:var(--fg3);padding:1rem">No DPPs logged yet</div>';
}

// Syllabus
function loadSyllabusProgress(){
    let p={};try{p=JSON.parse(localStorage.getItem('syllabus_progress')||'{}');}catch(e){}
    const MASTER={'Mathematics':['Basic Maths (Mod & Log)','Quadratic Equations','Trigonometry','Progression & Series','Binomial Theorem','Straight Lines','Permutation & Combination','Set Theory','Statistics'],'Physics':['Centre of Mass','Work Power Energy','Kinematics','Units & Dimensions','Rotational Motion','Fluid & Elasticity','SHM'],'Chemistry':['Concentration Terms & Eudiometry','Atomic Structure','Periodic Table','IUPAC Nomenclature','Chemical Equilibrium','Ionic Equilibrium','Ideal Gas','Chemical Bonding','Redox Reactions','Stereoisomers']};
    const SK={Mathematics:'11-maths',Physics:'11-physics',Chemistry:'11-chemistry'},cols={Mathematics:'var(--math)',Physics:'var(--phys)',Chemistry:'var(--chem)'};
    let tot=0,dn=0;
    const html=Object.entries(MASTER).map(([subj,chapters])=>{
        const ids=chapters.map(n=>`${SK[subj]}-${n}`.replace(/\s+/g,'-').toLowerCase());
        const done=ids.filter(id=>p[id]&&(p[id].status==='completed'||p[id].status==='revised')).length;
        const pct=chapters.length?Math.round(done/chapters.length*100):0;
        tot+=chapters.length;dn+=done;
        return`<div class="syl-subj-row"><div class="syl-row-top"><div class="syl-name" style="color:${cols[subj]}">${subj}</div><div class="syl-pct">${done}/${chapters.length}</div></div><div class="syl-track"><div class="syl-fill" style="width:${pct}%;background:${cols[subj]}"></div></div></div>`;
    }).join('');
    document.getElementById('sylBadge').textContent=tot?Math.round(dn/tot*100)+'%':'0%';
    document.getElementById('sylSubjBars').innerHTML=html;
}

// Test Widget
function loadTestWidget(){
    let tests=[];try{tests=JSON.parse(localStorage.getItem('test_analysis_data')||'[]');}catch(e){}
    document.getElementById('testBadge').textContent=tests.length+' TESTS';
    document.getElementById('statTestCount').textContent=tests.length;
    if(!tests.length)return;
    const sorted=[...tests].sort((a,b)=>new Date(b.date||0)-new Date(a.date||0));
    const last=sorted[0],total=(last.total??last.totalMarks??last.score??((last.physics||0)+(last.chemistry||0)+(last.maths||0))),max=last.maxMarks||300;
    const pct=max?Math.round(total/max*100):0;
    const avg=tests.reduce((a,t)=>{const s=t.total||t.totalMarks||t.score||0,m=t.maxMarks||300;return a+(m?s/m*100:0);},0)/tests.length;
    const subs=[{n:'Physics',s:last.physics||last.physicsScore||0,m:last.physicsMax||100,c:'var(--phys)'},{n:'Chemistry',s:last.chemistry||last.chemistryScore||0,m:last.chemistryMax||100,c:'var(--chem)'},{n:'Maths',s:last.maths||last.mathsScore||last.mathematics||0,m:last.mathsMax||100,c:'var(--math)'}];
    document.getElementById('testWidgetContent').innerHTML=`
        <div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:rgba(255,255,255,0.03);border-radius:var(--r2);border:1px solid var(--bd);margin-bottom:10px;">
            <div><div style="font-family:var(--fm);font-size:0.52rem;color:var(--fg3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:2px">LAST TEST</div><div style="font-family:var(--fd);font-size:2rem;color:var(--vio);line-height:1;">${total}<span style="font-size:0.9rem;color:var(--fg3)">/${max}</span></div></div>
            <div style="flex:1;min-width:0;margin-left:6px;"><div style="font-size:0.78rem;color:var(--fg1);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(last.testName||last.name||'Unnamed Test')}</div><div style="font-family:var(--fm);font-size:0.56rem;color:var(--fg3);margin-top:2px;">${last.date?new Date(last.date).toLocaleDateString('en-IN',{day:'numeric',month:'short'}):''} · ${pct}% · Avg ${Math.round(avg)}%</div></div>
        </div>
        ${subs.map(s=>`<div class="test-bar-row"><div class="test-bar-top"><div class="test-bar-name">${s.n}</div><div class="test-bar-val">${s.s}/${s.m}</div></div><div class="test-bar-track"><div class="test-bar-fill" style="width:${s.m?Math.round(s.s/s.m*100):0}%;background:${s.c}"></div></div></div>`).join('')}`;
}

// Tasks from localStorage
function loadTasks(){
    try{
        const raw=localStorage.getItem('buddy_tasks');
        const tasks=raw?JSON.parse(raw):[];
        const pending=tasks.filter(t=>!t.completed);
        const done=tasks.filter(t=>t.completed).length;
        document.getElementById('taskBadge').textContent=pending.length+' pending';
        document.getElementById('statTasksDone').textContent=done;
        if(!pending.length){
            document.getElementById('taskList').innerHTML='<div class="empty-card"><div class="empty-ico">📋</div><div class="empty-t">No tasks yet · Click to add</div></div>';
            return;
        }
        document.getElementById('taskList').innerHTML=pending.slice(0,4).map(t=>`<div class="task-row"><div class="task-cb"></div><div class="task-text">${esc(t.text||t.title||'Task')}</div></div>`).join('')+(pending.length>4?`<div style="font-family:var(--fm);font-size:0.6rem;color:var(--fg3);padding:6px 0;">+ ${pending.length-4} more</div>`:'');
    }catch(e){}
}

setInterval(()=>{if(_cu&&_sm==='cloud')syncToCloud();},30000);

// Canvas
const cv=document.getElementById('canvas-bg'),ct=cv.getContext('2d');let W=innerWidth,H=innerHeight;
const pts=Array.from({length:50},()=>({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.4+0.2,vx:(Math.random()-.5)*.18,vy:(Math.random()-.5)*.18,col:Math.random()>0.5?'91,110,245':'245,166,35',a:Math.random()*.09+.015}));
(function draw(){ct.clearRect(0,0,W,H);pts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;ct.beginPath();ct.arc(p.x,p.y,p.r,0,Math.PI*2);ct.fillStyle=`rgba(${p.col},${p.a})`;ct.fill();});requestAnimationFrame(draw);})();
window.addEventListener('resize',()=>{W=cv.width=innerWidth;H=cv.height=innerHeight;});cv.width=W;cv.height=H;
</script>

