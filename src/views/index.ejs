    catch(e){showToastMsg('Too many requests — wait a minute.');}
}

// Detect mobile/Android to use redirect instead of popup (popups break on Android)
function isMobile(){return /Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop/i.test(navigator.userAgent);}

async function signInWithGoogle(){
    try{
        const p=new firebase.auth.GoogleAuthProvider();
        p.addScope('profile');p.addScope('email');
        localStorage.setItem('buddy_storage_mode','cloud');
        if(isMobile()){
            // Store intent so we can show login screen on redirect return
            localStorage.setItem('buddy_auth_redirect','google');
            await firebase.auth().signInWithRedirect(p);
        } else {
            await firebase.auth().signInWithPopup(p);
        }
    }
    catch(e){if(e.code!=='auth/popup-closed-by-user')showToastMsg(friendlyErr(e.code));}
}
async function signInWithMicrosoft(){
    try{
        const p=new firebase.auth.OAuthProvider('microsoft.com');
        p.setCustomParameters({prompt:'select_account'});
        localStorage.setItem('buddy_storage_mode','cloud');
        if(isMobile()){
            localStorage.setItem('buddy_auth_redirect','microsoft');
            await firebase.auth().signInWithRedirect(p);
        } else {
            await firebase.auth().signInWithPopup(p);
        }
    }
    catch(e){if(e.code!=='auth/popup-closed-by-user')showToastMsg(friendlyErr(e.code));}
}
async function doLogout(){
    try{await firebase.auth().signOut();}catch(e){}
    localStorage.removeItem('buddy_storage_mode');location.reload();
}

