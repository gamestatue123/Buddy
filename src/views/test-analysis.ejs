function renderDetailQs() {
    const t=tests.find(x=>x.id===currentDetailId),list=document.getElementById('detailQList');
    if(!t||(t.questions||[]).length===0){list.innerHTML='';return;}
    list.innerHTML=(t.questions).map(q=>`<div class="qitem"><div class="qdot ${q.status}" onclick="cycleDetailQ('${q.id}')">${q.status==='correct'?'✓':q.status==='wrong'?'✗':'—'}</div><div class="qtext"><span style="font-family:var(--fm);font-size:0.63rem;color:var(--fg3);">Q${q.number}</span> · ${esc(q.topic||'—')}</div><button class="qdel" onclick="delDetailQ('${q.id}')">✕</button></div>`).join('');
}

function addDetailQ() {
    const num=document.getElementById('dqNum').value,topic=document.getElementById('dqTopic').value.trim(),status=document.getElementById('dqStatus').value;
    if(!topic){showToast('Enter a topic');return;}
    const t=tests.find(x=>x.id===currentDetailId);if(!t)return;
    if(!t.questions)t.questions=[];
    t.questions.push({id:Date.now().toString(),number:num||'?',topic,status});
    document.getElementById('dqNum').value='';document.getElementById('dqTopic').value='';
    saveTests();renderDetailQs();
}

function cycleDetailQ(qid){const cyc={correct:'wrong',wrong:'skipped',skipped:'correct'};const t=tests.find(x=>x.id===currentDetailId);if(!t)return;const q=(t.questions||[]).find(x=>x.id===qid);if(q){q.status=cyc[q.status];saveTests();renderDetailQs();}}
function delDetailQ(qid){const t=tests.find(x=>x.id===currentDetailId);if(!t)return;t.questions=(t.questions||[]).filter(x=>x.id!==qid);saveTests();renderDetailQs();}
function deleteTest(){if(!confirm('Delete this test permanently?'))return;tests=tests.filter(x=>x.id!==currentDetailId);saveTests();closeModal('detailModal');showToast('Test deleted');}

// ═══ IMPORT / EXPORT ═══
function exportData() {
    const blob=new Blob([JSON.stringify(tests,null,2)],{type:'application/json'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');a.href=url;a.download=`buddy_tests_${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(url);
    showToast('📦 Data exported');
}

function importData(e) {
    const file=e.target.files[0];if(!file)return;
    const reader=new FileReader();
    reader.onload=function(ev){
        try{
            const parsed=JSON.parse(ev.target.result);
            const raw=Array.isArray(parsed)?parsed:(Array.isArray(parsed.tests)?parsed.tests:(Array.isArray(parsed.data)?parsed.data:[]));
            if(!Array.isArray(raw)||!raw.length)throw new Error('Expected array of tests');
            const existingIds=new Set(tests.map(t=>t.id));
            let added=0;
            raw.forEach(t=>{
                const norm={id:t.id||(Date.now()+'_'+Math.random()),testName:t.testName||t.name||'Imported Test',date:t.date||'',physics:+(t.physics||t.physicsScore||0),physicsMax:+(t.physicsMax||100),chemistry:+(t.chemistry||t.chemistryScore||0),chemistryMax:+(t.chemistryMax||100),maths:+(t.maths||t.mathsScore||t.mathematics||0),mathsMax:+(t.mathsMax||100),maxMarks:+(t.maxMarks||300),totalQuestions:+(t.totalQuestions||0),rank:t.rank||'',questions:t.questions||[]};
                if(!existingIds.has(norm.id)){tests.push(norm);existingIds.add(norm.id);added++;}
            });
            if(added>0){saveTests();showToast(`✓ Imported ${added} test${added>1?'s':''}`);}
            else{showToast('All tests already exist — nothing new imported');}
        }catch(err){showToast('⚠️ Invalid JSON — use exported Buddy data');}
        e.target.value='';
    };
    reader.readAsText(file);
}

// ═══ UPCOMING TEST (single active plan) ═══
function renderUpcomingPlan(){
    const el=document.getElementById('upcomingPlanCard');
    if(!el)return;
    let plan={};
    try{plan=JSON.parse(localStorage.getItem('active_test_plan')||'{}');}catch(e){}
    if(!plan.examName||!plan.examDate){
        el.innerHTML='<div class="es"><div class="es-ico">⏳</div><div class="es-hl">NO UPCOMING TEST SET</div><div class="es-sub">Use Configure to set one focused upcoming test plan.</div></div>';
        return;
    }
    const rem=Math.ceil((new Date(plan.examDate+'T09:00:00')-new Date())/86400000);
    el.innerHTML=`<div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;"><div class="sc"><div class="sc-label">Exam</div><div class="sc-val" style="font-size:1.2rem;color:var(--amber)">${esc(plan.examName)}</div><div class="sc-sub">single active target</div></div><div class="sc"><div class="sc-label">Date</div><div class="sc-val" style="color:var(--acc2)">${new Date(plan.examDate+'T00:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})}</div><div class="sc-sub">planned</div></div><div class="sc"><div class="sc-label">Days Left</div><div class="sc-val" style="color:var(--grn)">${rem>0?rem:'GO'}</div><div class="sc-sub">countdown</div></div><div class="sc"><div class="sc-label">Revision Target</div><div class="sc-val" style="color:var(--vio)">${plan.revisionTarget||0}%</div><div class="sc-sub">syllabus coverage</div></div></div>${plan.notes?`<div style="margin-top:8px;font-family:var(--fm);font-size:0.66rem;color:var(--fg2);border-top:1px solid var(--bd);padding-top:8px;">Notes: ${esc(plan.notes)}</div>`:''}`;
}
function configureUpcomingPlan(){
    let plan={};
    try{plan=JSON.parse(localStorage.getItem('active_test_plan')||'{}');}catch(e){}
    const examName=prompt('Upcoming test name?',plan.examName||'');
    if(examName===null)return;
    const examDate=prompt('Upcoming test date (YYYY-MM-DD)?',plan.examDate||'');
    if(examDate===null)return;
    const revisionTarget=prompt('Revision target %?',String(plan.revisionTarget||70));
    if(revisionTarget===null)return;
    const notes=prompt('Notes / strategy (optional):',plan.notes||'');
    localStorage.setItem('active_test_plan',JSON.stringify({examName:examName.trim(),examDate:examDate.trim(),revisionTarget:Number(revisionTarget)||0,notes:(notes||'').trim()}));
    renderUpcomingPlan();
    showToast('✓ Upcoming test plan updated');
}

