        <div class="fg"><label>Chemistry</label><div style="display:flex;gap:6px;"><input id="mChem" type="number" placeholder="Score" style="flex:2"><input id="mChemMax" type="number" placeholder="100" value="100" style="flex:1"></div></div>
        <div class="fg full"><label>Maths</label><div style="display:flex;gap:6px;"><input id="mMath" type="number" placeholder="Score" style="flex:2"><input id="mMathMax" type="number" placeholder="100" value="100" style="flex:1"></div></div>
