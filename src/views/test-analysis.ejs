    <meta name="apple-mobile-web-app-title" content="Buddy">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/logo.png">
    <link rel="apple-touch-icon" href="/logo.png">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/mobile.css">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
    <script>
    if(!firebase.apps.length){firebase.initializeApp({apiKey:"AIzaSyCtu9xTssIZD3S99ekm2gwc1PySwiv0h9Y",authDomain:"buddy-app-jee.firebaseapp.com",projectId:"buddy-app-jee",storageBucket:"buddy-app-jee.firebasestorage.app",messagingSenderId:"888730193846",appId:"1:888730193846:web:4cfc94b24cdb3323e03b17"});}
    </script>

    <style>
    :root{
        --fd:'Bebas Neue',sans-serif;--fm:'JetBrains Mono',monospace;--fb:'Outfit',sans-serif;
        --ink:#080a10;--ink2:#0c0f18;--ink3:#121520;--ink4:#191d2a;--ink5:#202535;
        --bd:rgba(255,255,255,0.07);--bdh:rgba(255,255,255,0.13);
        --fg1:#e8ebf8;--fg2:#8590aa;--fg3:#444d68;
        --acc:var(--acc);--acc2:var(--acc2);--amber:#f5a623;--red:#f04444;--grn:#2dcf9e;--vio:#a78bfa;
        --phys:#4da6ff;--chem:#2dcf9e;--math:#f5a623;
        --r2:12px;--r3:18px;--r4:24px;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:var(--fb);background:var(--ink);color:var(--fg1);overflow-x:hidden;min-height:100vh;}
    ::-webkit-scrollbar{width:4px;height:4px;}::-webkit-scrollbar-thumb{background:var(--ink5);border-radius:2px;}

    .main-content{padding:2rem 2.2rem 5rem;overflow-y:auto;}

    /* PAGE HEADER */
    .page-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:2rem;gap:1rem;flex-wrap:wrap;}
    .page-eyebrow{font-family:var(--fm);font-size:0.6rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--vio);margin-bottom:4px;display:flex;align-items:center;gap:8px;}
    .page-eyebrow::before{content:'';width:16px;height:1px;background:var(--vio);}
    .page-title{font-family:var(--fd);font-size:clamp(2.2rem,4vw,3.4rem);letter-spacing:0.04em;line-height:1;background:linear-gradient(120deg,var(--fg1) 0%,var(--vio) 50%,var(--acc2) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
    .page-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}

    /* BUTTONS */
    .btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:50px;font-family:var(--fm);font-size:0.7rem;letter-spacing:0.05em;cursor:pointer;transition:all 0.18s;border:none;white-space:nowrap;}
    .btn-primary{background:var(--vio);color:#fff;box-shadow:0 4px 18px rgba(167,139,250,0.3);}
    .btn-primary:hover{background:#b8a2fb;transform:translateY(-1px);box-shadow:0 8px 24px rgba(167,139,250,0.4);}
    .btn-ghost{background:rgba(255,255,255,0.04);border:1px solid var(--bd);color:var(--fg2);}
    .btn-ghost:hover{border-color:var(--bdh);color:var(--fg1);background:rgba(255,255,255,0.07);}
    .btn-micro{background:none;border:1px dashed rgba(255,255,255,0.1);color:var(--fg3);padding:5px 10px;border-radius:6px;font-family:var(--fm);font-size:0.58rem;letter-spacing:0.06em;cursor:pointer;transition:all 0.18s;display:inline-flex;align-items:center;gap:4px;}
    .btn-micro:hover{border-color:var(--vio);color:var(--vio);}

    /* STAT ROW */
    .stat-row{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:1.6rem;}
    .sc{background:var(--ink2);border:1px solid var(--bd);border-radius:var(--r3);padding:1rem;position:relative;overflow:hidden;transition:border-color 0.2s,transform 0.18s;cursor:default;}
    .sc:hover{border-color:var(--bdh);transform:translateY(-2px);}
    .sc::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--bar,var(--vio));opacity:0.7;}
    .sc-label{font-family:var(--fm);font-size:0.55rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--fg3);margin-bottom:6px;}
    .sc-val{font-family:var(--fd);font-size:2rem;letter-spacing:0.03em;line-height:1;}
    .sc-sub{font-family:var(--fm);font-size:0.56rem;color:var(--fg3);margin-top:3px;}

    /* GRID */
    .g2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}
    .g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px;}
    .g75{display:grid;grid-template-columns:7fr 5fr;gap:12px;margin-bottom:12px;}
    .g57{display:grid;grid-template-columns:5fr 7fr;gap:12px;margin-bottom:12px;}

    /* CARD */
    .card{background:var(--ink2);border:1px solid var(--bd);border-radius:var(--r4);overflow:hidden;position:relative;}
    .card:hover{border-color:var(--bdh);}
    .cglow{position:absolute;width:140px;height:140px;border-radius:50%;pointer-events:none;filter:blur(48px);opacity:0.1;top:-40px;right:-40px;}
    .ch{padding:1rem 1.2rem 0;display:flex;align-items:center;justify-content:space-between;}
    .chl{display:flex;align-items:center;gap:8px;}
    .cdot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
    .ct{font-family:var(--fd);font-size:1.05rem;letter-spacing:0.07em;color:var(--fg2);}
    .cbadge{font-family:var(--fm);font-size:0.58rem;padding:3px 8px;border-radius:50px;background:rgba(167,139,250,0.12);color:var(--vio);border:1px solid rgba(167,139,250,0.2);}
    .cb{padding:1rem 1.2rem 1.2rem;}
    .cw{position:relative;width:100%;}

    /* SUBJECT BARS */
    .sbar{margin-bottom:10px;}
    .sbar-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;}
    .sbar-name{font-size:0.78rem;font-weight:500;}
    .sbar-val{font-family:var(--fm);font-size:0.62rem;color:var(--fg3);}
    .sbar-track{height:6px;background:rgba(255,255,255,0.06);border-radius:3px;overflow:hidden;}
    .sbar-fill{height:100%;border-radius:3px;transition:width 1s ease;}

    /* TABLE */
    .tw{overflow-x:auto;}
    table{width:100%;border-collapse:collapse;white-space:nowrap;}
    thead th{font-family:var(--fm);font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--fg3);padding:8px 12px;border-bottom:1px solid var(--bd);text-align:left;font-weight:400;}
    tbody td{padding:9px 12px;border-bottom:1px solid rgba(255,255,255,0.025);font-size:0.82rem;}
    tbody tr{transition:background 0.12s;cursor:pointer;}
    tbody tr:hover{background:rgba(255,255,255,0.025);}
    .bdg{padding:3px 9px;border-radius:50px;font-family:var(--fm);font-size:0.58rem;letter-spacing:0.04em;}
    .bg{background:rgba(45,207,158,0.12);color:var(--grn);border:1px solid rgba(45,207,158,0.25);}
    .ba{background:rgba(245,166,35,0.12);color:var(--amber);border:1px solid rgba(245,166,35,0.25);}
    .br{background:rgba(240,68,68,0.12);color:var(--red);border:1px solid rgba(240,68,68,0.25);}

    /* INSIGHTS */
    .irow{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;}
    .itag{display:flex;align-items:center;gap:6px;padding:7px 12px;background:rgba(255,255,255,0.03);border:1px solid var(--bd);border-radius:var(--r2);font-size:0.78rem;color:var(--fg2);}
    .itag.good{border-color:rgba(45,207,158,0.25);background:rgba(45,207,158,0.04);color:var(--grn);}
    .itag.warn{border-color:rgba(245,166,35,0.25);background:rgba(245,166,35,0.04);color:var(--amber);}
    .itag.bad{border-color:rgba(240,68,68,0.25);background:rgba(240,68,68,0.04);color:var(--red);}
    .itag.info{border-color:rgba(167,139,250,0.25);background:rgba(167,139,250,0.04);color:var(--vio);}

    /* SCORE RING */
    .ringwrap{display:flex;align-items:center;justify-content:center;gap:1.6rem;padding:0.5rem 0;}
    .ringo{position:relative;width:110px;height:110px;flex-shrink:0;}
    .rsvg{transform:rotate(-90deg);}
    .rbg{fill:none;stroke:rgba(255,255,255,0.06);stroke-width:6;}
    .rfill{fill:none;stroke-width:6;stroke-linecap:round;transition:stroke-dashoffset 1s ease;}
    .rcenter{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
    .rpct{font-family:var(--fd);font-size:1.6rem;letter-spacing:0.03em;line-height:1;}
    .rlbl{font-family:var(--fm);font-size:0.52rem;color:var(--fg3);letter-spacing:0.06em;text-transform:uppercase;}
    .rl{display:flex;flex-direction:column;gap:8px;}
    .rli{display:flex;align-items:center;gap:8px;font-family:var(--fm);font-size:0.65rem;}
    .rldot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}

    /* DETAIL BARS */
    .dsr{display:flex;align-items:center;gap:12px;margin-bottom:10px;}
    .dsn{font-family:var(--fm);font-size:0.65rem;letter-spacing:0.06em;text-transform:uppercase;width:72px;flex-shrink:0;}
    .dst{flex:1;height:8px;background:rgba(255,255,255,0.06);border-radius:4px;overflow:hidden;}
    .dsf{height:100%;border-radius:4px;transition:width 1s ease;}
    .dsv{font-family:var(--fm);font-size:0.65rem;color:var(--fg3);width:50px;text-align:right;flex-shrink:0;}

    /* MODAL */
    .moverlay{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;padding:1rem;background:rgba(4,6,14,0.9);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);opacity:0;pointer-events:none;transition:opacity 0.3s;}
    .moverlay.open{opacity:1;pointer-events:all;}
    .mbox{width:560px;max-width:96vw;max-height:90vh;overflow-y:auto;background:var(--ink2);border:1px solid rgba(255,255,255,0.1);border-radius:var(--r4);box-shadow:0 40px 80px rgba(0,0,0,0.7),inset 0 1px 0 rgba(255,255,255,0.05);position:relative;scrollbar-width:none;}
    .mbox::-webkit-scrollbar{display:none;}
    .mstrip{height:3px;background:linear-gradient(90deg,var(--vio),var(--acc));border-radius:var(--r4) var(--r4) 0 0;}
    .mhead{display:flex;align-items:center;justify-content:space-between;padding:1.4rem 1.6rem 0;}
    .mtitle{font-family:var(--fd);font-size:1.6rem;letter-spacing:0.05em;}
    .mclose{background:none;border:none;color:var(--fg3);cursor:pointer;font-size:1.2rem;padding:2px 6px;transition:color 0.15s;}
    .mclose:hover{color:var(--red);}
    .mbody{padding:1.2rem 1.6rem 1.6rem;}

    /* FORM */
    .fg2col{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    .fg{margin-bottom:0;}
    .fg.full{grid-column:1/-1;}
    .fg label{font-family:var(--fm);font-size:0.57rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--fg3);display:block;margin-bottom:5px;}
    .fg input,.fg select{width:100%;padding:9px 12px;background:var(--ink3);border:1px solid var(--bd);border-radius:var(--r2);color:var(--fg1);font-family:var(--fb);font-size:0.85rem;outline:none;transition:border-color 0.18s,box-shadow 0.18s;}
    .fg input:focus,.fg select:focus{border-color:var(--vio);box-shadow:0 0 0 3px rgba(167,139,250,0.1);}
    .fg input::placeholder{color:var(--fg3);}
    .fg select option{background:var(--ink3);}
    .sec-title{font-family:var(--fm);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--fg3);margin:1.2rem 0 8px;}

    /* Q ITEMS */
    .qadder{display:flex;gap:6px;padding:10px;background:rgba(255,255,255,0.02);border:1px dashed rgba(255,255,255,0.08);border-radius:var(--r2);margin-bottom:8px;}
    .qadder input,.qadder select{flex:1;padding:7px 10px;background:var(--ink3);border:1px solid var(--bd);border-radius:var(--r2);color:var(--fg1);font-family:var(--fm);font-size:0.72rem;outline:none;}
    .qadder input:focus,.qadder select:focus{border-color:var(--vio);}
    .qadder select option{background:var(--ink3);}
    .qlist{display:flex;flex-direction:column;gap:4px;max-height:200px;overflow-y:auto;}
    .qitem{display:flex;align-items:center;gap:8px;padding:7px 10px;background:rgba(255,255,255,0.025);border-radius:var(--r2);}
    .qdot{width:22px;height:22px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:0.62rem;cursor:pointer;flex-shrink:0;font-weight:700;}
    .qdot.correct{background:rgba(45,207,158,0.15);color:var(--grn);}
    .qdot.wrong{background:rgba(240,68,68,0.15);color:var(--red);}
    .qdot.skipped{background:rgba(255,255,255,0.06);color:var(--fg3);}
    .qtext{flex:1;font-size:0.78rem;}
    .qdel{background:none;border:none;color:var(--fg3);cursor:pointer;font-size:0.78rem;padding:2px 4px;transition:color 0.15s;}
    .qdel:hover{color:var(--red);}

    /* TOAST */
    .toast-el{position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(18px);background:var(--ink3);border:1px solid var(--bdh);color:var(--fg1);padding:8px 18px;border-radius:50px;font-family:var(--fm);font-size:0.72rem;opacity:0;pointer-events:none;transition:all 0.22s;z-index:99999;box-shadow:0 8px 28px rgba(0,0,0,0.5);}
    .toast-el.show{opacity:1;transform:translateX(-50%) translateY(0);}

    /* EMPTY */
    .es{text-align:center;padding:3.5rem 2rem;}
    .es-ico{font-size:2.8rem;opacity:0.2;margin-bottom:10px;}
    .es-hl{font-family:var(--fd);font-size:1.7rem;letter-spacing:0.06em;color:var(--fg2);margin-bottom:5px;}
    .es-sub{font-family:var(--fm);font-size:0.66rem;color:var(--fg3);letter-spacing:0.04em;}

    /* RESPONSIVE */
    @media(max-width:1100px){.g75,.g57,.g2{grid-template-columns:1fr;}.g3{grid-template-columns:1fr 1fr;}.stat-row{grid-template-columns:repeat(3,1fr);}}
    @media(max-width:700px){.stat-row{grid-template-columns:repeat(2,1fr);}.g3{grid-template-columns:1fr;}.main-content{padding:1.2rem 1rem 4rem;}}
    </style>
</head>
<body class="test-analysis-page">
<canvas id="canvas-bg" style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:-2;pointer-events:none;"></canvas>
<div class="gradient-orb orb-1"></div><div class="gradient-orb orb-2"></div>

<div class="app">
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="buddy-logo">
        <img src="/logo.png" alt="Buddy">
        <h1>Buddy</h1>
      </div>
      <p class="greeting">Test Analysis</p>
    </div>
    <nav class="nav-menu">
      <a href="/" class="nav-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 9L12 3L21 9V20C21 20.55 20.55 21 20 21H15V15H9V21H4C3.45 21 3 20.55 3 20V9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span>Overview</span></a>
      <a href="/timetable" class="nav-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2V6M8 2V6M3 10H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Timetable</span></a>
      <a href="/dpp" class="nav-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>DPP Logger</span></a>
      <a href="/syllabus" class="nav-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 4H20V20H4V4Z" stroke="currentColor" stroke-width="1.5"/><path d="M8 7H16M8 11H14M8 15H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Syllabus</span></a>
      <a href="/test-analysis" class="nav-item active"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Test Analysis</span></a>
    </nav>
    <div class="sidebar-footer">
      <div id="sidebarUserSlot"></div>
      <div class="streak-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15 8L22 9L17 14L18 21L12 17L6 21L7 14L2 9L9 8L12 2Z"/></svg><span id="streakDisp">—</span></div>
    </div>
  </aside>

  <main class="main-content">
    <!-- HEADER -->
    <div class="page-header">
      <div>
        <div class="page-eyebrow">PERFORMANCE HUB · JEE PREP</div>
        <div class="page-title">TEST ANALYSIS</div>
      </div>
      <div class="page-actions">
        <button class="btn-micro" title="Import test JSON" onclick="document.getElementById('importFile').click()">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>IMPORT
        </button>
        <input type="file" id="importFile" accept=".json" style="display:none;" onchange="importData(event)">
        <button class="btn-micro" title="How to import using AI" onclick="openImportGuide()" style="border-color:rgba(167,139,250,0.3);color:var(--vio);">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 16v-4M12 8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>HOW TO IMPORT
        </button>
        <button class="btn btn-ghost" onclick="exportData()">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>EXPORT
        </button>
        <button class="btn btn-primary" onclick="openAddModal()">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>LOG TEST
        </button>
      </div>
    </div>

    <div class="card" style="margin-bottom:12px;">
      <div class="ch"><div class="chl"><div class="cdot" style="background:var(--amber)"></div><div class="ct">UPCOMING TEST PLAN</div></div><button class="btn btn-ghost" onclick="configureUpcomingPlan()">Configure</button></div>
      <div class="cb" id="upcomingPlanCard"></div>
    </div>

    <!-- STATS -->
    <div class="stat-row">
      <div class="sc" style="--bar:var(--vio)"><div class="sc-label">Tests Taken</div><div class="sc-val" id="sTotal" style="color:var(--vio)">0</div><div class="sc-sub">all time</div></div>
      <div class="sc" style="--bar:var(--acc)"><div class="sc-label">Avg Total</div><div class="sc-val" id="sAvg" style="color:var(--acc2)">—</div><div class="sc-sub">out of 300</div></div>
      <div class="sc" style="--bar:var(--grn)"><div class="sc-label">Best Score</div><div class="sc-val" id="sBest" style="color:var(--grn)">—</div><div class="sc-sub">highest ever</div></div>
      <div class="sc" style="--bar:var(--phys)"><div class="sc-label">Physics Avg</div><div class="sc-val" id="sPhy" style="color:var(--phys)">—</div><div class="sc-sub">out of 100</div></div>
      <div class="sc" style="--bar:var(--chem)"><div class="sc-label">Chem Avg</div><div class="sc-val" id="sChem" style="color:var(--chem)">—</div><div class="sc-sub">out of 100</div></div>
      <div class="sc" style="--bar:var(--math)"><div class="sc-label">Maths Avg</div><div class="sc-val" id="sMath" style="color:var(--math)">—</div><div class="sc-sub">out of 100</div></div>
    </div>

    <!-- ROW 1: Trend + Radar -->
    <div class="g75">
      <div class="card" style="background:linear-gradient(135deg,#0c0e1a,#0d1022);">
        <div class="cglow" style="background:var(--vio)"></div>
        <div class="ch"><div class="chl"><div class="cdot" style="background:var(--vio)"></div><div class="ct">SCORE TRAJECTORY</div></div><div class="cbadge" id="trendBadge">—</div></div>
        <div class="cb"><div class="cw" style="height:240px"><canvas id="trendChart"></canvas></div></div>
      </div>
      <div class="card">
        <div class="ch"><div class="chl"><div class="cdot" style="background:var(--acc)"></div><div class="ct">SUBJECT BALANCE</div></div></div>
        <div class="cb"><div class="cw" style="height:240px"><canvas id="radarChart"></canvas></div></div>
      </div>
    </div>

    <!-- ROW 2: Subject breakdown + Accuracy ring + Weakness bar -->
    <div class="g3">
      <div class="card">
        <div class="cglow" style="background:var(--acc)"></div>
        <div class="ch"><div class="chl"><div class="cdot" style="background:var(--acc)"></div><div class="ct">SUBJECT BREAKDOWN</div></div></div>
        <div class="cb">
          <div class="sbar"><div class="sbar-top"><div class="sbar-name" style="color:var(--phys)">Physics</div><div class="sbar-val" id="sbPhy">—</div></div><div class="sbar-track"><div class="sbar-fill" id="sbPhyF" style="width:0%;background:var(--phys)"></div></div></div>
          <div class="sbar"><div class="sbar-top"><div class="sbar-name" style="color:var(--chem)">Chemistry</div><div class="sbar-val" id="sbChem">—</div></div><div class="sbar-track"><div class="sbar-fill" id="sbChemF" style="width:0%;background:var(--chem)"></div></div></div>
          <div class="sbar"><div class="sbar-top"><div class="sbar-name" style="color:var(--math)">Maths</div><div class="sbar-val" id="sbMath">—</div></div><div class="sbar-track"><div class="sbar-fill" id="sbMathF" style="width:0%;background:var(--math)"></div></div></div>
          <div style="margin-top:1rem;padding-top:10px;border-top:1px solid var(--bd);">
            <div style="font-family:var(--fm);font-size:0.56rem;color:var(--fg3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:6px;">STACKED SCORE / TEST</div>
            <div class="cw" style="height:90px"><canvas id="distroChart"></canvas></div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="ch"><div class="chl"><div class="cdot" style="background:var(--grn)"></div><div class="ct">QUESTION ACCURACY</div></div></div>
        <div class="cb">
          <div class="ringwrap">
            <div class="ringo">
              <svg class="rsvg" width="110" height="110" viewBox="0 0 110 110">
                <defs><linearGradient id="rg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#2dcf9e"/><stop offset="100%" style="stop-color:var(--acc)"/></linearGradient></defs>
                <circle class="rbg" cx="55" cy="55" r="46"/>
                <circle class="rfill" id="accRing" cx="55" cy="55" r="46" stroke="url(#rg)" stroke-dasharray="289.03" stroke-dashoffset="289.03"/>
              </svg>
              <div class="rcenter"><div class="rpct" id="accPct" style="color:var(--grn)">—</div><div class="rlbl">ACCURACY</div></div>
            </div>
            <div class="rl">
              <div class="rli"><div class="rldot" style="background:var(--grn)"></div><span style="color:var(--fg3)">Correct</span><span style="margin-left:auto;color:var(--fg1);font-weight:600;" id="qC">0</span></div>
              <div class="rli"><div class="rldot" style="background:var(--red)"></div><span style="color:var(--fg3)">Wrong</span><span style="margin-left:auto;color:var(--fg1);font-weight:600;" id="qW">0</span></div>
              <div class="rli"><div class="rldot" style="background:var(--amber)"></div><span style="color:var(--fg3)">Skipped</span><span style="margin-left:auto;color:var(--fg1);font-weight:600;" id="qS">0</span></div>
            </div>
          </div>
          <div class="cw" style="height:110px;margin-top:12px"><canvas id="doughnutChart"></canvas></div>
        </div>
      </div>

      <div class="card">
        <div class="cglow" style="background:var(--red)"></div>
        <div class="ch"><div class="chl"><div class="cdot" style="background:var(--red)"></div><div class="ct">CRITICAL WEAKNESSES</div></div></div>
        <div class="cb"><div class="cw" style="height:200px"><canvas id="barChart"></canvas></div></div>
      </div>
    </div>

    <!-- INSIGHTS -->
    <div class="card" style="margin-bottom:12px;">
      <div class="cglow" style="background:var(--acc);opacity:0.07;width:200px;height:200px;"></div>
      <div class="ch"><div class="chl"><div class="cdot" style="background:var(--acc)"></div><div class="ct">SMART INSIGHTS</div></div></div>
      <div class="cb"><div class="irow" id="insightRow"><div class="itag info">Log your first test to unlock insights.</div></div></div>
    </div>

    <!-- ROW 3: Improvement delta + Grouped subject bars -->
    <div class="g57">
      <div class="card">
        <div class="ch"><div class="chl"><div class="cdot" style="background:var(--amber)"></div><div class="ct">IMPROVEMENT RATE</div></div></div>
        <div class="cb"><div class="cw" style="height:190px"><canvas id="improveChart"></canvas></div></div>
      </div>
      <div class="card">
        <div class="ch"><div class="chl"><div class="cdot" style="background:var(--vio)"></div><div class="ct">SUBJECT SCORES PER TEST</div></div></div>
        <div class="cb"><div class="cw" style="height:190px"><canvas id="groupedBar"></canvas></div></div>
      </div>
    </div>

    <!-- TABLE -->
    <div class="card">
      <div class="ch"><div class="chl"><div class="cdot" style="background:var(--fg3)"></div><div class="ct">TEST HISTORY</div></div><div class="cbadge" id="histBadge">0 TESTS</div></div>
      <div class="cb">
        <div class="tw">
          <table>
            <thead><tr><th>DATE</th><th>TEST NAME</th><th>TOTAL</th><th>PHY</th><th>CHEM</th><th>MATH</th><th>ACCURACY</th><th>RANK</th><th></th></tr></thead>
            <tbody id="testTbody">
              <tr><td colspan="9"><div class="es"><div class="es-ico">📊</div><div class="es-hl">NO TESTS YET</div><div class="es-sub">Click LOG TEST to start tracking your performance</div></div></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- ADD TEST MODAL -->
<div class="moverlay" id="addModal">
  <div class="mbox">
    <div class="mstrip"></div>
    <div class="mhead"><div class="mtitle">LOG TEST</div><button class="mclose" onclick="closeModal('addModal')">✕</button></div>
    <div class="mbody">
      <div class="fg2col">
        <div class="fg full"><label>Test Name</label><input id="mName" type="text" placeholder="e.g. AITS Mock 4, JEE Main Part Test"></div>
