// Countdown — always shows JEE exam only, never hijacked by test plans
function getOrPromptTargetYear(){
    let p={};try{p=JSON.parse(localStorage.getItem('buddy_profile')||'{}');}catch(e){}
    if(p.targetYear)return p.targetYear;
    return new Date().getFullYear()+1;
}
function updateCountdown(){
    const cdDays=document.getElementById('cdDays');if(!cdDays)return;
    let p={};try{p=JSON.parse(localStorage.getItem('buddy_profile')||'{}');}catch(e){}
    const targetYear=p.targetYear||(new Date().getFullYear()+1);
    // Always JEE Mains — Jan 20 of target year, never overridden by test plans
    const examDateStr=targetYear+'-01-20';
    const examName=('JEE MAINS '+targetYear).toUpperCase();
    const exam=new Date(examDateStr+'T09:00:00');
    const now=new Date();
    const rem=exam-now;
    const cdExam=document.querySelector('.cd-exam');if(cdExam)cdExam.textContent=examName;
    if(rem<=0){cdDays.textContent='GO!';return;}
    const d=Math.floor(rem/86400000);
    cdDays.textContent=d;
    const cw=document.getElementById('cdWeeks'),cm=document.getElementById('cdMonths'),ch=document.getElementById('cdHours'),cr=document.getElementById('cdRingFill'),cp=document.getElementById('cdPct');
    if(cw)cw.textContent=Math.floor(d/7);
    if(cm)cm.textContent=Math.floor(d/30.44);
    if(ch)ch.textContent=Math.min(Math.floor(rem/3600000),9999);
    // Ring % = how far through prep journey (start date → exam date)
    const startStr=p.prepStartDate||`${targetYear-1}-06-01`;
    const start=new Date(startStr+'T00:00:00');
    const totalSpan=exam-start;
    const elapsed=now-start;
    const pct=totalSpan>0?Math.max(0,Math.min(1,elapsed/totalSpan)):0;
    if(cr)cr.style.strokeDashoffset=232.48*(1-pct);
    if(cp)cp.textContent=Math.round(pct*100)+'%';
}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',()=>{updateCountdown();setInterval(updateCountdown,60000);});}
else{updateCountdown();setInterval(updateCountdown,60000);}

