async function syncFromCloud(){
    if(!_cu)return;
    const uid=_cu.uid;
    try{
        const snap=await firebase.firestore().collection('users').doc(uid).collection('tests').get();
        const tests=[];snap.forEach(d=>tests.push(d.data()));
        if(tests.length)localStorage.setItem('test_analysis_data',JSON.stringify(tests));
        const qSnap=await firebase.firestore().collection('users').doc(uid).collection('tasks').get();
        const tasks=[];qSnap.forEach(d=>tasks.push(d.data()));
        if(tasks.length)localStorage.setItem('dpp_questions',JSON.stringify({'11':tasks,'12':[]}));
        const sylSnap=await firebase.firestore().collection('users').doc(uid).collection('syllabus').get();
        const syl={};sylSnap.forEach(d=>syl[d.id]=d.data());
        if(Object.keys(syl).length)localStorage.setItem('syllabus_progress',JSON.stringify(syl));
    }catch(e){console.warn('syncFromCloud failed',e);}
}
async function syncToCloud(){
    if(!_cu||_sm!=='cloud'||_si)return; _si=true;
    document.getElementById('syncStatusText').textContent='⟳ SYNCING';
    try{
        const uid=_cu.uid,raw=localStorage.getItem('test_analysis_data');
        if(raw){const tests=JSON.parse(raw);const ref=firebase.firestore().collection('users').doc(uid).collection('tests');const old=await ref.get();old.forEach(d=>d.ref.delete());for(const t of tests)await ref.add(t);}
        document.getElementById('syncStatusText').textContent='CLOUD ✓';
        setTimeout(()=>{try{document.getElementById('syncStatusText').textContent='CLOUD ✓';}catch(e){}},2500);
    }catch(e){document.getElementById('syncStatusText').textContent='⚠ FAILED';}
    finally{_si=false;}
}
