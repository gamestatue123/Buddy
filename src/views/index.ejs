function ensureAuthListener(){
    if(_al)return; _al=true;

    // Handle redirect return (mobile Google/Microsoft sign-in)
    // getRedirectResult resolves immediately on desktop (null) and on mobile after redirect
    firebase.auth().getRedirectResult().then(result=>{
        if(result&&result.user){
            // onAuthStateChanged will fire and handle the rest
            localStorage.setItem('buddy_storage_mode','cloud');
            localStorage.removeItem('buddy_auth_redirect');
        }
    }).catch(e=>{
        localStorage.removeItem('buddy_auth_redirect');
        if(e.code&&e.code!=='auth/no-auth-event')showToastMsg(friendlyErr(e.code)||'Sign-in failed. Try again.');
    });

    firebase.auth().onAuthStateChanged(async user=>{
        if(user){
            _cu=user; _sm='cloud';
            if(!secretInviteCode){secretInviteCode=_makeSecretCode(user.uid);localStorage.setItem(CHAT_SECRET_STORAGE_KEY,secretInviteCode);}
            localStorage.setItem('buddy_storage_mode','cloud');
            showUserPill(user);
            document.getElementById('syncStatusText').textContent='CLOUD ✓';
            await syncFromCloud();
            closeOverlay();
            // Check if profile has targetYear; if not, prompt before loading
            let p={};try{p=JSON.parse(localStorage.getItem('buddy_profile')||'{}');}catch(e){}
            if(!p.targetYear){
                showJeeYearModal((yr,prepType,batch,startDate)=>{p.targetYear=yr;if(prepType)p.prepType=prepType;if(batch)p.batch=batch;if(startDate)p.prepStartDate=startDate;localStorage.setItem('buddy_profile',JSON.stringify(p));loadPageData();updateCountdown();});
            } else {
                loadPageData();
            }
            const lb=document.getElementById('loginBtn'),sb=document.getElementById('signupBtn');
            if(lb){lb.innerHTML='SIGN IN';lb.disabled=false;}
            if(sb){sb.innerHTML='CREATE ACCOUNT';sb.disabled=false;}
        }else{
            _cu=null;
        }
        if(document.getElementById('buddyChatModal')?.classList.contains('open')) refreshBuddyChatRoom();
    });
}

window.addEventListener('DOMContentLoaded',()=>{
    ensureAuthListener();
    const mode=localStorage.getItem('buddy_storage_mode');
    const pendingRedirect=localStorage.getItem('buddy_auth_redirect');
    // Always load whatever data exists in localStorage so widgets aren't blank
    loadPageData();
    if(pendingRedirect){
        // Coming back from Google/Microsoft redirect — show a brief "signing in" state,
        // don't show login overlay; getRedirectResult + onAuthStateChanged will handle it
        _sm='cloud';
        showToastMsg('🔄 Completing sign-in…');
        // Safety fallback: if still not signed in after 8s, show login screen
        setTimeout(()=>{if(!_cu){localStorage.removeItem('buddy_auth_redirect');showScreen('screenLogin');openOverlay();}},8000);
    }
    else if(!mode){showScreen('screenStorage');openOverlay();}
    else if(mode==='local'){_sm='local';loadLocalData();}
    else{_sm='cloud';setTimeout(()=>{if(!_cu){showScreen('screenLogin');openOverlay();}},1600);}
});

function selectStorage(mode){
    _sm=mode; localStorage.setItem('buddy_storage_mode',mode);
    if(mode==='local'){
        let p={};try{p=JSON.parse(localStorage.getItem('buddy_profile')||'{}');}catch(e){}
