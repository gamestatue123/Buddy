            <td style="color:var(--chem);font-family:var(--fm);font-size:0.78rem;">${t.chemistry}<span style="color:var(--fg3);font-size:0.62rem;">/${t.chemistryMax||100}</span></td>
            <td style="color:var(--math);font-family:var(--fm);font-size:0.78rem;">${t.maths}<span style="color:var(--fg3);font-size:0.62rem;">/${t.mathsMax||100}</span></td>
            <td style="font-family:var(--fm);font-size:0.72rem;">${acc}</td>
            <td style="font-family:var(--fm);font-size:0.66rem;color:var(--fg3);">${t.rank||'—'}</td>
