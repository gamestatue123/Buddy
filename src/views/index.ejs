    setTimeout(()=>{
        const di=overlay.querySelector('#jymStartDate');
        if(di){
            // default: June 1 of year before target (will update when year pill clicked)
            const yr=(defYear-1);
            di.value=`${yr}-06-01`;
            di.max=new Date().toISOString().split('T')[0];
