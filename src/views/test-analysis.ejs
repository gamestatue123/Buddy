// ═══ CANVAS ═══
function initCanvas(){
    const cv=document.getElementById('canvas-bg'),ct=cv.getContext('2d');let W=cv.width=innerWidth,H=cv.height=innerHeight;
    const pts=Array.from({length:40},()=>({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.2+0.2,vx:(Math.random()-.5)*.15,vy:(Math.random()-.5)*.15,col:Math.random()>0.5?'167,139,250':'91,110,245',a:Math.random()*.08+.01}));
    (function draw(){ct.clearRect(0,0,W,H);pts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;ct.beginPath();ct.arc(p.x,p.y,p.r,0,Math.PI*2);ct.fillStyle=`rgba(${p.col},${p.a})`;ct.fill();});requestAnimationFrame(draw);})();
    window.addEventListener('resize',()=>{W=cv.width=innerWidth;H=cv.height=innerHeight;});
}

