async function _loadGifApiKey(){
    if(gifApiKey)return gifApiKey;
    if(!gifConfigPromise)gifConfigPromise=fetch('/api/gifs/config',{cache:'no-store'}).then(r=>{if(!r.ok)throw new Error('config');return r.json();}).then(data=>{
        if(!data?.enabled||!data?.apiKey)throw new Error('not-configured');
        gifApiKey=data.apiKey;return gifApiKey;
    }).catch(e=>{gifConfigPromise=null;throw e;});
    return gifConfigPromise;
}
function _renderGifResults(append=false){
    const host=document.getElementById('gifResults');if(!host)return;
    const html=gifSearchResults.map(g=>{
        const preview=g.images?.fixed_height_small?.url||g.images?.downsized_medium?.url||g.images?.original?.url||'';
        const full=g.images?.original?.url||g.images?.fixed_height?.url||preview;
        if(!_chatSafeGifUrl(preview)||!_chatSafeGifUrl(full))return '';
        return '<button class="chat-gif-card" type="button" data-send-gif data-gif-url="'+_chatEsc(full)+'" data-gif-id="'+_chatEsc(g.id||'')+'" data-gif-title="'+_chatEsc(g.title||'GIF')+'" aria-label="Send GIF: '+_chatEsc(g.title||'GIF')+'"><img src="'+_chatEsc(preview)+'" alt="'+_chatEsc(g.title||'GIF')+'" loading="lazy"></button>';
    }).join('');
    const more=gifHasMore?'<button class="chat-gif-more" type="button" data-gif-more>Load more GIFs</button>':'';
    host.innerHTML=(html||'<div class="chat-gif-status">No GIFs found for this search. Try another phrase.</div>')+more;
}
async function searchGifs(loadMore=false){
    const input=document.getElementById('gifSearchInput'),host=document.getElementById('gifResults');if(!host)return;
    if(!loadMore){gifLastQuery=(input?.value||'').trim();gifSearchOffset=0;gifSearchResults=[];gifHasMore=false;host.innerHTML='<div class="chat-gif-status">Finding GIFs…</div>';}
    try{
        const key=await _loadGifApiKey();
        const kind=gifLastQuery?'search':'trending';
        const url=new URL('https://api.giphy.com/v1/gifs/'+kind);
        url.searchParams.set('api_key',key);url.searchParams.set('limit','24');url.searchParams.set('rating','g');url.searchParams.set('lang','en');
        if(gifLastQuery)url.searchParams.set('q',gifLastQuery);
        if(loadMore)url.searchParams.set('offset',String(gifSearchOffset));
        const response=await fetch(url.toString());
        if(!response.ok)throw new Error('provider');
        const data=await response.json(),items=Array.isArray(data.data)?data.data:[];
        gifSearchResults=loadMore?gifSearchResults.concat(items):items;
        gifSearchOffset=(data.pagination?.offset||0)+items.length;
        gifHasMore=items.length>0&&(data.pagination?.total_count||0)>gifSearchOffset;
        _renderGifResults(loadMore);
    }catch(e){
        host.innerHTML='<div class="chat-gif-status">'+(e.message==='not-configured'?'GIF search is not set up for this Buddy deployment yet.':'GIF search is temporarily unavailable. Please try again.')+'</div>';
    }
}

async function sendGifMessage(url,id,title){
    const safeUrl=_chatSafeGifUrl(url),rid=_chatRoomId();if(!rid||!safeUrl)return;
    const payload={
        text:'',gif:safeUrl,gifTitle:String(title||'GIF').slice(0,120),gifProvider:'giphy',gifId:String(id||'').slice(0,80),
        uid:_chatActorId(),name:_chatActorName(),createdAt:firebase.firestore.FieldValue.serverTimestamp()
    };
    if(chatReplyTo)payload.replyTo={id:chatReplyTo.id,name:chatReplyTo.name,text:(chatReplyTo.text||'').slice(0,240),gif:Boolean(chatReplyTo.gif)};
    try{
        await firebase.firestore().collection('chatrooms').doc(rid).collection('messages').add(payload);
        clearChatReply();closeChatPopups();
    }catch(e){showToastMsg('Could not send GIF');}
}
