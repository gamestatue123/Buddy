        <input id="qNum" type="number" placeholder="Q#" style="flex:0 0 56px;width:56px;">
        <input id="qTopic" type="text" placeholder="Topic e.g. Rotation, Thermo">
        <select id="qStatus"><option value="correct">✓ Correct</option><option value="wrong">✗ Wrong</option><option value="skipped">— Skip</option></select>
        <button class="btn btn-primary" onclick="addStagedQ()" style="padding:7px 12px;border-radius:var(--r2);flex-shrink:0;">+</button>
      </div>
      <div class="qlist" id="qList"></div>
      <div style="display:flex;gap:8px;margin-top:1.4rem;">
        <button class="btn btn-primary" style="flex:1;" onclick="saveTest()">SAVE RESULT</button>
        <button class="btn btn-ghost" style="flex:0 0 auto;" onclick="closeModal('addModal')">CANCEL</button>
      </div>
