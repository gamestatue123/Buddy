  </div>
</div>

<!-- DETAIL MODAL -->
<div class="moverlay" id="detailModal">
  <div class="mbox">
    <div class="mstrip" style="background:linear-gradient(90deg,var(--acc),var(--grn));"></div>
    <div class="mhead"><div class="mtitle" id="detailTitle">TEST DETAIL</div><button class="mclose" onclick="closeModal('detailModal')">✕</button></div>
    <div class="mbody">
      <div id="detailContent"></div>
      <div class="sec-title" style="margin-top:1.2rem;">Add Question Analysis</div>
      <div class="qadder">
        <input id="dqNum" type="number" placeholder="Q#" style="flex:0 0 56px;width:56px;">
        <input id="dqTopic" type="text" placeholder="Topic">
        <select id="dqStatus"><option value="correct">✓ Correct</option><option value="wrong">✗ Wrong</option><option value="skipped">— Skip</option></select>
        <button class="btn btn-primary" onclick="addDetailQ()" style="padding:7px 12px;border-radius:var(--r2);flex-shrink:0;">+</button>
      </div>
      <div class="qlist" id="detailQList"></div>
