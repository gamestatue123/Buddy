    if(!e||!p){showAuthErr(err,'Enter your email and password.');return;}
    err.classList.remove('show');btn.innerHTML='<span class="auth-spinner"></span>SIGNING IN...';btn.disabled=true;
    try{await firebase.auth().signInWithEmailAndPassword(e,p);}
    catch(ex){showAuthErr(err,friendlyErr(ex.code));btn.innerHTML='SIGN IN';btn.disabled=false;}
}

async function doSignup(){
    const n=document.getElementById('signupName').value.trim(),cls=document.getElementById('signupClass').value,targetYear=document.getElementById('signupTargetYear').value.trim(),batch=document.getElementById('signupBatch').value.trim(),e=document.getElementById('signupEmail').value.trim(),p=document.getElementById('signupPassword').value,c=document.getElementById('signupConfirm').value;
    const err=document.getElementById('signupError'),btn=document.getElementById('signupBtn');
    if(!n||!e||!p||!targetYear){showAuthErr(err,'Name, target year, email and password are required.');return;}
    if(p!==c){showAuthErr(err,'Passwords do not match.');return;}
    if(p.length<6){showAuthErr(err,'Password must be at least 6 characters.');return;}
    err.classList.remove('show');btn.innerHTML='<span class="auth-spinner"></span>CREATING...';btn.disabled=true;
    try{
        const cred=await firebase.auth().createUserWithEmailAndPassword(e,p);
        await cred.user.updateProfile({displayName:n});
        const profile={name:n,classLevel:cls,targetYear:Number(targetYear),batch:batch||'Self-study',email:e,createdAt:new Date().toISOString()};localStorage.setItem('buddy_profile',JSON.stringify(profile));firebase.firestore().collection('users').doc(cred.user.uid).set(profile).catch(()=>{});
        await cred.user.sendEmailVerification();
        document.getElementById('verifyEmailDisplay').textContent=e;
        showScreen('screenVerify');
        btn.innerHTML='CREATE ACCOUNT';btn.disabled=false;
    }catch(ex){showAuthErr(err,friendlyErr(ex.code));btn.innerHTML='CREATE ACCOUNT';btn.disabled=false;}
}

async function checkVerification(){
