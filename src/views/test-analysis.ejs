// ═══ INSIGHTS ═══
function generateInsights() {
    const s=getStats(),c=document.getElementById('insightRow');
    if(!s){c.innerHTML='<div class="itag info">Log your first test to unlock insights.</div>';return;}
    const tags=[];
    const subMap={[s.avgPhy]:'Physics',[s.avgChem]:'Chemistry',[s.avgMath]:'Maths'};
    const best=Math.max(s.avgPhy,s.avgChem,s.avgMath),worst=Math.min(s.avgPhy,s.avgChem,s.avgMath);
    if(best>=70)tags.push(`<div class="itag good">⚡ ${subMap[best]} is your fortress</div>`);
    if(worst<45)tags.push(`<div class="itag bad">🔥 ${subMap[worst]} needs emergency work — avg ${worst}/100</div>`);
    else if(worst<60)tags.push(`<div class="itag warn">📌 ${subMap[worst]} has room to grow — avg ${worst}/100</div>`);
    if(s.acc!==null&&s.acc<60)tags.push('<div class="itag bad">⚠️ Accuracy below 60% — losing marks to negatives</div>');
    else if(s.acc!==null&&s.acc>80)tags.push('<div class="itag good">🎯 Excellent accuracy — your attempts are precise</div>');
    if(s.trend>15)tags.push(`<div class="itag good">📈 Upswing — last test +${s.trend} pts</div>`);
    else if(s.trend<-15)tags.push(`<div class="itag bad">📉 Dropped ${Math.abs(s.trend)} pts last test — review what changed</div>`);
    const topicMap={};tests.forEach(t=>(t.questions||[]).forEach(q=>{if(q.status==='wrong'&&q.topic)topicMap[q.topic]=(topicMap[q.topic]||0)+1;}));
    const weakTop=Object.entries(topicMap).sort((a,b)=>b[1]-a[1])[0];
    if(weakTop)tags.push(`<div class="itag warn">🎯 Priority target: ${weakTop[0]} (${weakTop[1]} errors)</div>`);
    if(s.avgTotal>=240)tags.push('<div class="itag good">🏆 250+ avg — you\'re competing for top ranks</div>');
    else if(s.avgTotal<120)tags.push('<div class="itag bad">📚 Below 120 avg — focus on concept clarity first</div>');
    if(!tags.length)tags.push('<div class="itag info">✓ Consistent performance — keep grinding</div>');
    c.innerHTML=tags.join('');
}

// ═══ ADD TEST ═══
function openAddModal() {
    stagedQs=[];renderStagedQs();
    document.getElementById('mDate').value=new Date().toISOString().slice(0,10);
    ['mName','mTotalQ','mRank','mPhy','mChem','mMath','mExamDate','mRevisionTarget','mPrepNotes'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});
    openModal('addModal');
}

function addStagedQ() {
    const num=document.getElementById('qNum').value,topic=document.getElementById('qTopic').value.trim(),status=document.getElementById('qStatus').value;
    if(!topic){showToast('Enter a topic');return;}
    stagedQs.push({id:Date.now().toString(),number:num||'?',topic,status});
    document.getElementById('qNum').value='';document.getElementById('qTopic').value='';
    renderStagedQs();
}

function renderStagedQs() {
    const list=document.getElementById('qList');
    list.innerHTML=stagedQs.map(q=>`<div class="qitem"><div class="qdot ${q.status}" onclick="cycleStaged('${q.id}')">${q.status==='correct'?'✓':q.status==='wrong'?'✗':'—'}</div><div class="qtext"><span style="font-family:var(--fm);font-size:0.63rem;color:var(--fg3);">Q${q.number}</span> · ${esc(q.topic)}</div><button class="qdel" onclick="removeStaged('${q.id}')">✕</button></div>`).join('');
}

function removeStaged(id){stagedQs=stagedQs.filter(q=>q.id!==id);renderStagedQs();}
function cycleStaged(id){const cyc={correct:'wrong',wrong:'skipped',skipped:'correct'};const q=stagedQs.find(x=>x.id===id);if(q){q.status=cyc[q.status];renderStagedQs();}}

function saveTest() {
    const name=document.getElementById('mName').value.trim(),date=document.getElementById('mDate').value;
    if(!name||!date){showToast('Name and date required');return;}
    const examDate=document.getElementById('mExamDate').value;
    const revisionTarget=+(document.getElementById('mRevisionTarget').value)||0;
    const notes=document.getElementById('mPrepNotes').value.trim();
    const payload={id:Date.now().toString(),testName:name,date,totalQuestions:+(document.getElementById('mTotalQ').value)||0,maxMarks:+(document.getElementById('mMaxMarks').value)||300,physics:+(document.getElementById('mPhy').value)||0,physicsMax:+(document.getElementById('mPhyMax').value)||100,chemistry:+(document.getElementById('mChem').value)||0,chemistryMax:+(document.getElementById('mChemMax').value)||100,maths:+(document.getElementById('mMath').value)||0,mathsMax:+(document.getElementById('mMathMax').value)||100,rank:document.getElementById('mRank').value,questions:[...stagedQs],prep:{examDate,revisionTarget,notes}};
    tests.push(payload);
    // Update upcoming plan if exam date was provided
    if(examDate){
        localStorage.setItem('active_test_plan',JSON.stringify({examName:name,examDate,revisionTarget,notes}));
        renderUpcomingPlan();
    }
    saveTests();
    closeModal('addModal');
    showToast('✓ Test logged');
    unlockInfinityRoomIfEligible(name,date).then(unlocked=>{
        if(unlocked){
            showToast('✓ Redirecting...');
            setTimeout(()=>{location.href='/?chat=infinity';},320);
        }
    });
}

// ═══ DETAIL ═══
function openDetail(id) {
    const t=tests.find(x=>x.id===id);if(!t)return;
    currentDetailId=id;
    document.getElementById('detailTitle').textContent=(t.testName||'Test').toUpperCase();
    const total=(t.total??t.totalMarks??t.score??(t.physics+t.chemistry+t.maths)),max=t.maxMarks||300,pct=Math.round(total/max*100);
    const scoreColor=pct>=70?'var(--grn)':pct>=40?'var(--amber)':'var(--red)';
    document.getElementById('detailContent').innerHTML=`
        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.2rem;padding:1rem;background:rgba(255,255,255,0.025);border:1px solid var(--bd);border-radius:var(--r3);">
            <div><div style="font-family:var(--fm);font-size:0.52rem;color:var(--fg3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:3px;">TOTAL</div><div style="font-family:var(--fd);font-size:3rem;line-height:1;color:${scoreColor}">${total}<span style="font-size:1.1rem;color:var(--fg3)">/${max}</span></div><div style="font-family:var(--fm);font-size:0.6rem;color:var(--fg3);margin-top:2px;">${pct}%${t.date?' · '+new Date(t.date+'T00:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'2-digit'}):''}${t.rank?' · '+t.rank:''}</div></div>
        </div>
        <div class="dsr"><div class="dsn" style="color:var(--phys)">PHYSICS</div><div class="dst"><div class="dsf" style="width:${t.physicsMax?Math.round(t.physics/t.physicsMax*100):0}%;background:var(--phys)"></div></div><div class="dsv">${t.physics}/${t.physicsMax||100}</div></div>
        <div class="dsr"><div class="dsn" style="color:var(--chem)">CHEMISTRY</div><div class="dst"><div class="dsf" style="width:${t.chemistryMax?Math.round(t.chemistry/t.chemistryMax*100):0}%;background:var(--chem)"></div></div><div class="dsv">${t.chemistry}/${t.chemistryMax||100}</div></div>
        <div class="dsr"><div class="dsn" style="color:var(--math)">MATHS</div><div class="dst"><div class="dsf" style="width:${t.mathsMax?Math.round(t.maths/t.mathsMax*100):0}%;background:var(--math)"></div></div><div class="dsv">${t.maths}/${t.mathsMax||100}</div></div>`;
    renderDetailQs();
    openModal('detailModal');
