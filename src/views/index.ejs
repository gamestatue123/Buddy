        document.getElementById('jeeYearModal').remove();
        (window._jeeYearCb||function(){})(selYear,selPrep,batch,startDate);
    });
}

function ensureAuthListener(){
    if(_al)return; _al=true;

    // Handle redirect return (mobile Google/Microsoft sign-in)
    // getRedirectResult resolves immediately on desktop (null) and on mobile after redirect
    firebase.auth().getRedirectResult().then(result=>{
        if(result&&result.user){
            // onAuthStateChanged will fire and handle the rest
            localStorage.setItem('buddy_storage_mode','cloud');
            localStorage.removeItem('buddy_auth_redirect');
        }
    }).catch(e=>{
        localStorage.removeItem('buddy_auth_redirect');
        if(e.code&&e.code!=='auth/no-auth-event')showToastMsg(friendlyErr(e.code)||'Sign-in failed. Try again.');
    });

    firebase.auth().onAuthStateChanged(async user=>{
        if(user){
            _cu=user; _sm='cloud';
            if(!secretInviteCode){secretInviteCode=_makeSecretCode(user.uid);localStorage.setItem(CHAT_SECRET_STORAGE_KEY,secretInviteCode);}
            localStorage.setItem('buddy_storage_mode','cloud');
            showUserPill(user);
            document.getElementById('syncStatusText').textContent='CLOUD ✓';
            await syncFromCloud();
            closeOverlay();
            // Check if profile has targetYear; if not, prompt before loading
            let p={};try{p=JSON.parse(localStorage.getItem('buddy_profile')||'{}');}catch(e){}
            if(!p.targetYear){
                showJeeYearModal((yr,prepType,batch,startDate)=>{p.targetYear=yr;if(prepType)p.prepType=prepType;if(batch)p.batch=batch;if(startDate)p.prepStartDate=startDate;localStorage.setItem('buddy_profile',JSON.stringify(p));loadPageData();updateCountdown();});
            } else {
                loadPageData();
            }
            const lb=document.getElementById('loginBtn'),sb=document.getElementById('signupBtn');
            if(lb){lb.innerHTML='SIGN IN';lb.disabled=false;}
            if(sb){sb.innerHTML='CREATE ACCOUNT';sb.disabled=false;}
        }else{
            _cu=null;
        }
        if(document.getElementById('buddyChatModal')?.classList.contains('open')) refreshBuddyChatRoom();
    });
}

window.addEventListener('DOMContentLoaded',()=>{
    ensureAuthListener();
    const mode=localStorage.getItem('buddy_storage_mode');
    const pendingRedirect=localStorage.getItem('buddy_auth_redirect');
    // Always load whatever data exists in localStorage so widgets aren't blank
    loadPageData();
    if(pendingRedirect){
        // Coming back from Google/Microsoft redirect — show a brief "signing in" state,
        // don't show login overlay; getRedirectResult + onAuthStateChanged will handle it
        _sm='cloud';
        showToastMsg('🔄 Completing sign-in…');
        // Safety fallback: if still not signed in after 8s, show login screen
        setTimeout(()=>{if(!_cu){localStorage.removeItem('buddy_auth_redirect');showScreen('screenLogin');openOverlay();}},8000);
    }
    else if(!mode){showScreen('screenStorage');openOverlay();}
    else if(mode==='local'){_sm='local';loadLocalData();}
    else{_sm='cloud';setTimeout(()=>{if(!_cu){showScreen('screenLogin');openOverlay();}},1600);}
});

function selectStorage(mode){
    _sm=mode; localStorage.setItem('buddy_storage_mode',mode);
    if(mode==='local'){
        let p={};try{p=JSON.parse(localStorage.getItem('buddy_profile')||'{}');}catch(e){}
        if(!p.targetYear){
            showJeeYearModal((yr,prepType,batch,startDate)=>{p.targetYear=yr;if(prepType)p.prepType=prepType;if(batch)p.batch=batch;if(startDate)p.prepStartDate=startDate;localStorage.setItem('buddy_profile',JSON.stringify(p));closeOverlay();loadLocalData();updateCountdown();});
        } else {closeOverlay();loadLocalData();}
    }
    else{ensureAuthListener();if(!firebase.auth().currentUser)showScreen('screenLogin');}
}

async function doLogin(){
    const e=document.getElementById('loginEmail').value.trim(),p=document.getElementById('loginPassword').value;
    const err=document.getElementById('loginError'),btn=document.getElementById('loginBtn');
    if(!e||!p){showAuthErr(err,'Enter your email and password.');return;}
    err.classList.remove('show');btn.innerHTML='<span class="auth-spinner"></span>SIGNING IN...';btn.disabled=true;
    try{await firebase.auth().signInWithEmailAndPassword(e,p);}
    catch(ex){showAuthErr(err,friendlyErr(ex.code));btn.innerHTML='SIGN IN';btn.disabled=false;}
}

async function doSignup(){
    const n=document.getElementById('signupName').value.trim(),cls=document.getElementById('signupClass').value,targetYear=document.getElementById('signupTargetYear').value.trim(),batch=document.getElementById('signupBatch').value.trim(),e=document.getElementById('signupEmail').value.trim(),p=document.getElementById('signupPassword').value,c=document.getElementById('signupConfirm').value;
    const err=document.getElementById('signupError'),btn=document.getElementById('signupBtn');
    if(!n||!e||!p||!targetYear){showAuthErr(err,'Name, target year, email and password are required.');return;}
    if(p!==c){showAuthErr(err,'Passwords do not match.');return;}
    if(p.length<6){showAuthErr(err,'Password must be at least 6 characters.');return;}
    err.classList.remove('show');btn.innerHTML='<span class="auth-spinner"></span>CREATING...';btn.disabled=true;
    try{
        const cred=await firebase.auth().createUserWithEmailAndPassword(e,p);
        await cred.user.updateProfile({displayName:n});
        const profile={name:n,classLevel:cls,targetYear:Number(targetYear),batch:batch||'Self-study',email:e,createdAt:new Date().toISOString()};localStorage.setItem('buddy_profile',JSON.stringify(profile));firebase.firestore().collection('users').doc(cred.user.uid).set(profile).catch(()=>{});
        await cred.user.sendEmailVerification();
