<div class="toast-el" id="toast"></div>
<script>
// ═══ STATE ═══
let tests = [];
let charts = {};
let currentDetailId = null;
let stagedQs = [];

const C = { phys:'#4da6ff',chem:'#2dcf9e',math:'#f5a623',vio:'#a78bfa',acc:'#5b6ef5',acc2:'#7c8ff8',grn:'#2dcf9e',red:'#f04444',amber:'#f5a623',fg1:'#e8ebf8',fg2:'#8590aa',fg3:'#444d68',grid:'rgba(255,255,255,0.05)' };
const SECRET_UNLOCK_NAME='filter test infinity';
const SECRET_UNLOCK_DATE='1038-12-15';
const SECRET_CODE_KEY='buddy_secret_chat_code';
function buildSecretCode(uid=''){
    const seed=`${uid||'local'}|${SECRET_UNLOCK_DATE}|${SECRET_UNLOCK_NAME}`;
    let h=2166136261;
    for(let i=0;i<seed.length;i++){h^=seed.charCodeAt(i);h+=((h<<1)+(h<<4)+(h<<7)+(h<<8)+(h<<24));}
    return `INF-${Math.abs(h>>>0).toString(36).toUpperCase().slice(0,8)}`;
}
async function unlockInfinityRoomIfEligible(name,date){
    if((name||'').trim().toLowerCase()!==SECRET_UNLOCK_NAME || date!==SECRET_UNLOCK_DATE) return false;
    const code=buildSecretCode(firebase.auth().currentUser?.uid||'');
    localStorage.setItem(SECRET_CODE_KEY,code);
    localStorage.setItem('buddy_secret_chat_unlocked_at',new Date().toISOString());
    localStorage.setItem('buddy_auto_enter_infinity','1');
    if(firebase.auth().currentUser){
        try{
            await firebase.firestore().collection('users').doc(firebase.auth().currentUser.uid).set({
                secretRoom:{code,unlockedAt:firebase.firestore.FieldValue.serverTimestamp(),source:'filter_test_infinity'}
            },{merge:true});
        }catch(e){}
    }
    return true;
}

// ═══ INIT ═══
window.addEventListener('DOMContentLoaded', () => {
    initCanvas();
    loadTests();
    renderUpcomingPlan();
    Chart.defaults.color = C.fg2;
    Chart.defaults.font.family = "'JetBrains Mono', monospace";
    Chart.defaults.font.size = 11;
    document.getElementById('mDate').value = new Date().toISOString().slice(0,10);
});

// ═══ STORAGE ═══
function loadTests() {
    const raw = localStorage.getItem('test_analysis_data') || localStorage.getItem('buddy_test_data');
    if (raw) {
        try {
            tests = JSON.parse(raw).map(t => ({
                id: t.id || (Date.now()+''+Math.random()),
                testName: t.testName || t.name || 'Unnamed Test',
                date: t.date || '',
                physics: +(t.physics||t.physicsScore||0),
                physicsMax: +(t.physicsMax||100),
                chemistry: +(t.chemistry||t.chemistryScore||0),
                chemistryMax: +(t.chemistryMax||100),
                maths: +(t.maths||t.mathsScore||t.mathematics||0),
                mathsMax: +(t.mathsMax||100),
                maxMarks: +(t.maxMarks||300),
                totalQuestions: +(t.totalQuestions||0),
                rank: t.rank||'',
                questions: t.questions||[]
            }));
        } catch(e) { tests = []; }
    }
    updateDashboard();
}

function saveTests() {
    localStorage.setItem('test_analysis_data', JSON.stringify(tests));
    localStorage.setItem('buddy_test_data', JSON.stringify(tests));
    updateDashboard();
}

// ═══ STATS ═══
function getStats() {
    if (!tests.length) return null;
    let totals=[], phys=[], chem=[], math=[], qC=0, qW=0, qS=0;
    tests.forEach(t => {
        totals.push(t.physics+t.chemistry+t.maths);
        phys.push(t.physics); chem.push(t.chemistry); math.push(t.maths);
        (t.questions||[]).forEach(q => { if(q.status==='correct')qC++; else if(q.status==='wrong')qW++; else qS++; });
    });
    const avg = a => a.length ? Math.round(a.reduce((x,y)=>x+y,0)/a.length) : 0;
    return { count:tests.length, avgTotal:avg(totals), bestTotal:Math.max(...totals), worstTotal:Math.min(...totals), avgPhy:avg(phys), avgChem:avg(chem), avgMath:avg(math), qC, qW, qS, acc:(qC+qW)?Math.round(qC/(qC+qW)*100):null, trend:totals.length>1?totals[totals.length-1]-totals[totals.length-2]:0 };
}

// ═══ DASHBOARD ═══
function updateDashboard() { updateStats(); renderCharts(); renderTable(); generateInsights(); }

function updateStats() {
    const s = getStats();
    if (!s) { ['sTotal','sAvg','sBest','sPhy','sChem','sMath'].forEach(id=>{ document.getElementById(id).textContent=id==='sTotal'?'0':'—'; }); return; }
    document.getElementById('sTotal').textContent = s.count;
    document.getElementById('sAvg').textContent = s.avgTotal;
    document.getElementById('sBest').textContent = s.bestTotal;
    document.getElementById('sPhy').textContent = s.avgPhy;
    document.getElementById('sChem').textContent = s.avgChem;
    document.getElementById('sMath').textContent = s.avgMath;
    document.getElementById('histBadge').textContent = s.count+' TESTS';
    const tb = document.getElementById('trendBadge');
    if(s.trend>0){tb.textContent='↑ +'+s.trend+' pts';tb.style.cssText='background:rgba(45,207,158,0.12);color:#2dcf9e;border:1px solid rgba(45,207,158,0.25);font-family:var(--fm);font-size:0.58rem;padding:3px 8px;border-radius:50px;';}
    else if(s.trend<0){tb.textContent='↓ '+s.trend+' pts';tb.style.cssText='background:rgba(240,68,68,0.12);color:#f04444;border:1px solid rgba(240,68,68,0.25);font-family:var(--fm);font-size:0.58rem;padding:3px 8px;border-radius:50px;';}
    else{tb.textContent='→ STABLE';}
    document.getElementById('sbPhy').textContent=s.avgPhy+'/100';
    document.getElementById('sbChem').textContent=s.avgChem+'/100';
    document.getElementById('sbMath').textContent=s.avgMath+'/100';
    setTimeout(()=>{ document.getElementById('sbPhyF').style.width=s.avgPhy+'%'; document.getElementById('sbChemF').style.width=s.avgChem+'%'; document.getElementById('sbMathF').style.width=s.avgMath+'%'; },80);
    document.getElementById('accPct').textContent=s.acc!==null?s.acc+'%':'—';
    document.getElementById('qC').textContent=s.qC;
    document.getElementById('qW').textContent=s.qW;
    document.getElementById('qS').textContent=s.qS;
    if(s.acc!==null){ setTimeout(()=>{ document.getElementById('accRing').style.strokeDashoffset=289.03-(s.acc/100*289.03); },100); }
}

// ═══ CHARTS ═══
function dc(k){if(charts[k]){charts[k].destroy();delete charts[k];}}

function renderCharts() {
    if (!tests.length) return;
    const sorted=[...tests].sort((a,b)=>new Date(a.date)-new Date(b.date));
    const labels=sorted.map(t=>{const n=t.testName||'Test';return n.length>10?n.slice(0,10)+'…':n;});
    const totals=sorted.map(t=>t.physics+t.chemistry+t.maths);
    const phys=sorted.map(t=>t.physics),chem=sorted.map(t=>t.chemistry),math=sorted.map(t=>t.maths);

    // 1. TREND
    dc('trend');
    const ctx1=document.getElementById('trendChart').getContext('2d');
    const g1=ctx1.createLinearGradient(0,0,0,280);g1.addColorStop(0,'rgba(167,139,250,0.35)');g1.addColorStop(1,'rgba(167,139,250,0)');
    charts.trend=new Chart(ctx1,{type:'line',data:{labels,datasets:[
        {label:'Total',data:totals,borderColor:C.vio,backgroundColor:g1,borderWidth:2.5,tension:0.4,fill:true,pointBackgroundColor:C.vio,pointRadius:4,pointHoverRadius:6},
        {label:'Phy',data:phys,borderColor:C.phys+'cc',backgroundColor:'transparent',borderWidth:1.5,tension:0.4,pointRadius:2,borderDash:[4,3]},
        {label:'Chem',data:chem,borderColor:C.chem+'cc',backgroundColor:'transparent',borderWidth:1.5,tension:0.4,pointRadius:2,borderDash:[4,3]},
        {label:'Math',data:math,borderColor:C.math+'cc',backgroundColor:'transparent',borderWidth:1.5,tension:0.4,pointRadius:2,borderDash:[4,3]},
    ]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{display:true,position:'top',labels:{boxWidth:8,boxHeight:8,padding:10,usePointStyle:true}},tooltip:{backgroundColor:'rgba(9,11,20,0.92)',borderColor:'rgba(255,255,255,0.08)',borderWidth:1,padding:10}},scales:{y:{beginAtZero:false,grid:{color:C.grid},ticks:{stepSize:50}},x:{grid:{display:false}}}}});

    // 2. RADAR
    const s=getStats();
    dc('radar');
    const ctx2=document.getElementById('radarChart').getContext('2d');
    charts.radar=new Chart(ctx2,{type:'radar',data:{labels:['PHYSICS','CHEMISTRY','MATHS'],datasets:[{data:[s.avgPhy,s.avgChem,s.avgMath],backgroundColor:'rgba(91,110,245,0.16)',borderColor:C.acc,pointBackgroundColor:[C.phys,C.chem,C.math],pointRadius:5,borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,scales:{r:{angleLines:{color:C.grid},grid:{color:C.grid},pointLabels:{color:C.fg1,font:{size:12,family:"'Bebas Neue'"}},ticks:{display:false},min:0,max:100}},plugins:{legend:{display:false}}}});

    // 3. DOUGHNUT
    dc('doughnut');
    const ctx3=document.getElementById('doughnutChart').getContext('2d');
    let qC=0,qW=0,qS=0;tests.forEach(t=>(t.questions||[]).forEach(q=>{if(q.status==='correct')qC++;else if(q.status==='wrong')qW++;else qS++;}));
    charts.doughnut=new Chart(ctx3,{type:'doughnut',data:{labels:['Correct','Wrong','Skipped'],datasets:[{data:[qC||0.01,qW,qS],backgroundColor:[C.grn,C.red,C.amber],borderWidth:0,hoverOffset:4}]},options:{responsive:true,maintainAspectRatio:false,cutout:'72%',plugins:{legend:{display:false}}}});

    // 4. HORIZONTAL BAR (weaknesses)
    const topicMap={};tests.forEach(t=>(t.questions||[]).forEach(q=>{if(q.status==='wrong'&&q.topic)topicMap[q.topic]=(topicMap[q.topic]||0)+1;}));
    const weak=Object.entries(topicMap).sort((a,b)=>b[1]-a[1]).slice(0,6);
    dc('bar');
    const ctx4=document.getElementById('barChart').getContext('2d');
    charts.bar=new Chart(ctx4,{type:'bar',data:{labels:weak.length?weak.map(t=>t[0].length>14?t[0].slice(0,14)+'…':t[0]):['No data yet'],datasets:[{data:weak.length?weak.map(t=>t[1]):[0],backgroundColor:weak.map((_,i)=>`rgba(240,68,68,${0.88-i*0.1})`),borderRadius:4,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',plugins:{legend:{display:false}},scales:{x:{beginAtZero:true,grid:{color:C.grid},ticks:{stepSize:1}},y:{grid:{display:false}}}}});

    // 5. STACKED DISTRO
    dc('distro');
    const ctx5=document.getElementById('distroChart').getContext('2d');
    charts.distro=new Chart(ctx5,{type:'bar',data:{labels,datasets:[{label:'Phy',data:phys,backgroundColor:C.phys+'88',borderRadius:2},{label:'Chem',data:chem,backgroundColor:C.chem+'88',borderRadius:2},{label:'Math',data:math,backgroundColor:C.math+'88',borderRadius:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{mode:'index',intersect:false}},scales:{x:{stacked:true,grid:{display:false},ticks:{display:false}},y:{stacked:true,grid:{color:C.grid},max:300,ticks:{maxTicksLimit:3}}}}});

    // 6. IMPROVEMENT DELTA
    const deltas=totals.map((v,i)=>i===0?0:v-totals[i-1]);
    dc('improve');
    const ctx6=document.getElementById('improveChart').getContext('2d');
    charts.improve=new Chart(ctx6,{type:'bar',data:{labels,datasets:[{label:'Δ pts',data:deltas,backgroundColor:deltas.map(d=>d>=0?C.grn+'bb':C.red+'bb'),borderRadius:4,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{grid:{color:C.grid},ticks:{callback:v=>(v>0?'+':'')+v}},x:{grid:{display:false}}}}});

    // 7. GROUPED BAR
    dc('grouped');
    const ctx7=document.getElementById('groupedBar').getContext('2d');
    charts.grouped=new Chart(ctx7,{type:'bar',data:{labels,datasets:[{label:'Physics',data:phys,backgroundColor:C.phys+'bb',borderRadius:3},{label:'Chemistry',data:chem,backgroundColor:C.chem+'bb',borderRadius:3},{label:'Maths',data:math,backgroundColor:C.math+'bb',borderRadius:3}]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{display:true,position:'top',labels:{boxWidth:8,boxHeight:8,usePointStyle:true,padding:10}}},scales:{y:{beginAtZero:true,max:100,grid:{color:C.grid}},x:{grid:{display:false}}}}});
}

// ═══ TABLE ═══
function renderTable() {
    const tbody=document.getElementById('testTbody');
    if(!tests.length){tbody.innerHTML=`<tr><td colspan="9"><div class="es"><div class="es-ico">📊</div><div class="es-hl">NO TESTS YET</div><div class="es-sub">Click LOG TEST to begin</div></div></td></tr>`;return;}
    const sorted=[...tests].sort((a,b)=>new Date(b.date)-new Date(a.date));
    tbody.innerHTML=sorted.map(t=>{
        const total=(t.total??t.totalMarks??t.score??(t.physics+t.chemistry+t.maths)),max=t.maxMarks||300,pct=Math.round(total/max*100);
        const bc=pct>=70?'bg':pct>=40?'ba':'br';
        let qC=0,qW=0;(t.questions||[]).forEach(q=>{if(q.status==='correct')qC++;if(q.status==='wrong')qW++;});
        const acc=qC+qW?Math.round(qC/(qC+qW)*100)+'%':'—';
        const dt=t.date?new Date(t.date+'T00:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'2-digit'}):'—';
        return`<tr onclick="openDetail('${t.id}')">
