    const elTotal=document.getElementById('dppTotal'),elGood=document.getElementById('dppGood'),elTricky=document.getElementById('dppTricky'),elTough=document.getElementById('dppTough'),elCore=document.getElementById('dppCore'),elStat=document.getElementById('statDppCount');
    if(elTotal)elTotal.textContent=allQ.length;
    if(elGood)elGood.textContent=allQ.filter(q=>q.status==='good').length;
    if(elTricky)elTricky.textContent=allQ.filter(q=>q.status==='tricky').length;
    if(elTough)elTough.textContent=allQ.filter(q=>q.status==='tough').length;
    if(elCore)elCore.textContent=allQ.filter(q=>q.status==='fundamental').length;
    if(elStat)elStat.textContent=allQ.length;
    const SMAP={'Mathematics':['Basic Maths (Mod & Log)','Quadratic Equations','Trigonometry','Progression & Series','Binomial Theorem','Straight Lines','Permutation & Combination','Set Theory','Statistics'],'Physics':['Centre of Mass','Work Power Energy','Kinematics','Units & Dimensions','Rotational Motion','Fluid & Elasticity','SHM'],'Chemistry':['Concentration Terms & Eudiometry','Atomic Structure','Periodic Table','IUPAC Nomenclature','Chemical Equilibrium','Ionic Equilibrium','Ideal Gas','Chemical Bonding','Redox Reactions','Stereoisomers']};
    const bySub={Mathematics:0,Physics:0,Chemistry:0};
    allQ.forEach(q=>{for(const[s,cs]of Object.entries(SMAP)){if(cs.includes(q.chapter)){bySub[s]++;break;}}});
    const maxS=Math.max(...Object.values(bySub),1),cols={Mathematics:'var(--math)',Physics:'var(--phys)',Chemistry:'var(--chem)'};
    const elSubj=document.getElementById('subjBars');
    if(elSubj)elSubj.innerHTML=Object.entries(bySub).map(([s,n])=>`<div class="subj-row"><div class="subj-row-top"><div class="subj-name" style="color:${cols[s]}">${s}</div><div class="subj-pct">${n} Q</div></div><div class="subj-track"><div class="subj-fill" style="width:${Math.round(n/maxS*100)}%;background:${cols[s]}"></div></div></div>`).join('');
    const byChap={};allQ.forEach(q=>{byChap[q.chapter]=(byChap[q.chapter]||0)+1;});
    const top5=Object.entries(byChap).sort((a,b)=>b[1]-a[1]).slice(0,5),maxC=top5[0]?.[1]||1;
    const elBreakdown=document.getElementById('dppBreakdown');
    if(elBreakdown)elBreakdown.innerHTML=top5.map(([ch,n])=>{
        const t=allQ.filter(q=>q.chapter===ch&&(q.status==='tough'||q.status==='tricky')).length;
        return`<div style="display:flex;align-items:center;gap:8px"><div style="font-size:0.75rem;width:130px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--fg2)">${esc(ch.substring(0,18))}</div><div style="flex:1;height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden"><div style="width:${Math.round(n/maxC*100)}%;height:100%;background:linear-gradient(90deg,var(--acc),var(--acc2));border-radius:2px;"></div></div><div style="font-family:var(--fm);font-size:0.62rem;color:var(--fg3);width:28px;text-align:right">${n}</div>${t>0?`<div style="font-family:var(--fm);font-size:0.56rem;color:var(--red)">⚠${t}</div>`:'<div style="width:20px"></div>'}</div>`;
    }).join('')||'<div style="font-family:var(--fm);font-size:0.7rem;color:var(--fg3);padding:1rem">No DPPs logged yet</div>';
}

// Syllabus
function loadSyllabusProgress(){
    let p={};try{p=JSON.parse(localStorage.getItem('syllabus_progress')||'{}');}catch(e){}
    const MASTER={'Mathematics':['Basic Maths (Mod & Log)','Quadratic Equations','Trigonometry','Progression & Series','Binomial Theorem','Straight Lines','Permutation & Combination','Set Theory','Statistics'],'Physics':['Centre of Mass','Work Power Energy','Kinematics','Units & Dimensions','Rotational Motion','Fluid & Elasticity','SHM'],'Chemistry':['Concentration Terms & Eudiometry','Atomic Structure','Periodic Table','IUPAC Nomenclature','Chemical Equilibrium','Ionic Equilibrium','Ideal Gas','Chemical Bonding','Redox Reactions','Stereoisomers']};
    const SK={Mathematics:'11-maths',Physics:'11-physics',Chemistry:'11-chemistry'},cols={Mathematics:'var(--math)',Physics:'var(--phys)',Chemistry:'var(--chem)'};
    let tot=0,dn=0;
    const html=Object.entries(MASTER).map(([subj,chapters])=>{
        const ids=chapters.map(n=>`${SK[subj]}-${n}`.replace(/\s+/g,'-').toLowerCase());
        const done=ids.filter(id=>p[id]&&(p[id].status==='completed'||p[id].status==='revised')).length;
        const pct=chapters.length?Math.round(done/chapters.length*100):0;
        tot+=chapters.length;dn+=done;
        return`<div class="syl-subj-row"><div class="syl-row-top"><div class="syl-name" style="color:${cols[subj]}">${subj}</div><div class="syl-pct">${done}/${chapters.length}</div></div><div class="syl-track"><div class="syl-fill" style="width:${pct}%;background:${cols[subj]}"></div></div></div>`;
    }).join('');
    document.getElementById('sylBadge').textContent=tot?Math.round(dn/tot*100)+'%':'0%';
    document.getElementById('sylSubjBars').innerHTML=html;
}

// Test Widget
function loadTestWidget(){
    let tests=[];try{tests=JSON.parse(localStorage.getItem('test_analysis_data')||'[]');}catch(e){}
    document.getElementById('testBadge').textContent=tests.length+' TESTS';
    document.getElementById('statTestCount').textContent=tests.length;
    if(!tests.length)return;
    const sorted=[...tests].sort((a,b)=>new Date(b.date||0)-new Date(a.date||0));
    const last=sorted[0],total=(last.total??last.totalMarks??last.score??((last.physics||0)+(last.chemistry||0)+(last.maths||0))),max=last.maxMarks||300;
    const pct=max?Math.round(total/max*100):0;
    const avg=tests.reduce((a,t)=>{const s=t.total||t.totalMarks||t.score||0,m=t.maxMarks||300;return a+(m?s/m*100:0);},0)/tests.length;
    const subs=[{n:'Physics',s:last.physics||last.physicsScore||0,m:last.physicsMax||100,c:'var(--phys)'},{n:'Chemistry',s:last.chemistry||last.chemistryScore||0,m:last.chemistryMax||100,c:'var(--chem)'},{n:'Maths',s:last.maths||last.mathsScore||last.mathematics||0,m:last.mathsMax||100,c:'var(--math)'}];
    document.getElementById('testWidgetContent').innerHTML=`
        <div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:rgba(255,255,255,0.03);border-radius:var(--r2);border:1px solid var(--bd);margin-bottom:10px;">
            <div><div style="font-family:var(--fm);font-size:0.52rem;color:var(--fg3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:2px">LAST TEST</div><div style="font-family:var(--fd);font-size:2rem;color:var(--vio);line-height:1;">${total}<span style="font-size:0.9rem;color:var(--fg3)">/${max}</span></div></div>
            <div style="flex:1;min-width:0;margin-left:6px;"><div style="font-size:0.78rem;color:var(--fg1);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(last.testName||last.name||'Unnamed Test')}</div><div style="font-family:var(--fm);font-size:0.56rem;color:var(--fg3);margin-top:2px;">${last.date?new Date(last.date).toLocaleDateString('en-IN',{day:'numeric',month:'short'}):''} · ${pct}% · Avg ${Math.round(avg)}%</div></div>
        </div>
        ${subs.map(s=>`<div class="test-bar-row"><div class="test-bar-top"><div class="test-bar-name">${s.n}</div><div class="test-bar-val">${s.s}/${s.m}</div></div><div class="test-bar-track"><div class="test-bar-fill" style="width:${s.m?Math.round(s.s/s.m*100):0}%;background:${s.c}"></div></div></div>`).join('')}`;
}

// Tasks from localStorage
function loadTasks(){
    try{
        const raw=localStorage.getItem('buddy_tasks');
        const tasks=raw?JSON.parse(raw):[];
        const pending=tasks.filter(t=>!t.completed);
        const done=tasks.filter(t=>t.completed).length;
        document.getElementById('taskBadge').textContent=pending.length+' pending';
        document.getElementById('statTasksDone').textContent=done;
        if(!pending.length){
            document.getElementById('taskList').innerHTML='<div class="empty-card"><div class="empty-ico">📋</div><div class="empty-t">No tasks yet · Click to add</div></div>';
            return;
        }
        document.getElementById('taskList').innerHTML=pending.slice(0,4).map(t=>`<div class="task-row"><div class="task-cb"></div><div class="task-text">${esc(t.text||t.title||'Task')}</div></div>`).join('')+(pending.length>4?`<div style="font-family:var(--fm);font-size:0.6rem;color:var(--fg3);padding:6px 0;">+ ${pending.length-4} more</div>`:'');
    }catch(e){}
}

function readJsonArray(key){
    try{
        const raw=localStorage.getItem(key);
        if(!raw)return [];
        const parsed=JSON.parse(raw);
        return Array.isArray(parsed)?parsed:[];
    }catch(e){return [];}
}

function loadStudyHub(){
    const tests=readJsonArray('test_analysis_data');
    const tasks=readJsonArray('buddy_tasks');
    const backlog=readJsonArray('buddy_backlog');
    const timetable=readJsonArray('buddy_timetable');
    let schedule={};try{schedule=JSON.parse(localStorage.getItem('buddy_schedule')||'{}');}catch(e){}
    let syllabus={};try{syllabus=JSON.parse(localStorage.getItem('syllabus_progress')||'{}');}catch(e){}
    let dpp={};try{dpp=JSON.parse(localStorage.getItem('dpp_q2')||localStorage.getItem('dpp_questions')||'{}');}catch(e){}
    const dppTotal=[...(dpp['11']||[]),...(dpp['12']||[])].length;

    const doneTasks=tasks.filter(t=>t.completed).length;
    const pendingTasks=tasks.length-doneTasks;
    const backlogOpen=backlog.filter(b=>!b.done).length;
    const avgTestPct=tests.length?Math.round(tests.reduce((acc,t)=>{const score=t.total||t.totalMarks||t.score||0;const max=t.maxMarks||300;return acc+(max?score/max*100:0);},0)/tests.length):0;
    const syllabusItems=Object.values(syllabus);
    const syllabusDone=syllabusItems.filter(s=>s&&['completed','revised'].includes(s.status)).length;
    const syllabusPct=syllabusItems.length?Math.round((syllabusDone/syllabusItems.length)*100):0;
    const scheduleCount=Object.values(schedule).reduce((sum,d)=>sum+(Array.isArray(d)?d.length:0),0) || timetable.length;
    const taskPct=tasks.length?Math.round(doneTasks/tasks.length*100):0;
    const dppPct=Math.min(100,Math.round(dppTotal/1.2));
    const score=Math.max(0,Math.min(100,
        Math.round(avgTestPct*0.3 + (tasks.length?doneTasks/tasks.length*100:55)*0.2 + syllabusPct*0.2 + Math.min(dppTotal,120)/1.2*0.1 + Math.min(scheduleCount*4,100)*0.1 + Math.max(0,100-backlogOpen*12)*0.1)
    ));

    // date badge
    const dEl=document.getElementById('hubDate');
    if(dEl)dEl.textContent=new Date().toLocaleDateString(undefined,{weekday:'short',day:'numeric',month:'short'}).toUpperCase();

    // score ring + level + mini bars
    const C=276.46;
    const ring=document.getElementById('hubRing');
    if(ring)requestAnimationFrame(()=>{ring.style.strokeDashoffset=String(C*(1-score/100));});
    const sEl=document.getElementById('hubScore');if(sEl)sEl.textContent=score;
    const lvl=score>=80?'Exam ready':score>=60?'On track':score>=40?'Building momentum':'Getting started';
    const lEl=document.getElementById('hubLevel');if(lEl)lEl.textContent=lvl;
    const minis=[
        {n:'Tests',v:avgTestPct,c:'var(--vio)'},
        {n:'Syllabus',v:syllabusPct,c:'var(--acc)'},
        {n:'Tasks',v:taskPct,c:'var(--grn)'},
        {n:'DPP',v:dppPct,c:'var(--amber)'}
    ];
    const mEl=document.getElementById('hubMinis');
    if(mEl)mEl.innerHTML=minis.map(m=>`<div class="hub-mini"><span>${m.n}</span><div class="hub-mini-track"><div class="hub-mini-fill" style="width:${m.v}%;background:${m.c}"></div></div><span>${m.v}%</span></div>`).join('');

    // weekly focus minutes (written by the focus timer as pom_YYYY-MM-DD)
    const days=[];
    for(let i=6;i>=0;i--){
        const d=new Date();d.setDate(d.getDate()-i);
        let mins=0;try{mins=(JSON.parse(localStorage.getItem('pom_'+d.toISOString().slice(0,10))||'{}').focusMins)||0;}catch(e){}
        days.push({l:d.toLocaleDateString(undefined,{weekday:'narrow'}),mins,today:i===0});
    }
    const maxMin=Math.max(30,...days.map(d=>d.mins));
    const wEl=document.getElementById('hubWeek');
    if(wEl)wEl.innerHTML=days.map(d=>`<div class="hub-day ${d.mins?'on':''} ${d.today?'today':''}" title="${d.mins} min"><div class="hub-day-bar" style="height:${Math.max(4,Math.round(d.mins/maxMin*100))}%"></div><div class="hub-day-l">${d.l}</div></div>`).join('');
    const weekTotal=days.reduce((a,d)=>a+d.mins,0);
    const todayMin=days[6].mins;
    const fmt=m=>m>=60?`${Math.floor(m/60)}h ${m%60}m`:`${m}m`;
    const sumEl=document.getElementById('hubWeekSum');
    if(sumEl)sumEl.innerHTML=`<span>TODAY <b>${fmt(todayMin)}</b></span><span>THIS WEEK <b>${fmt(weekTotal)}</b></span>`;

    // next best actions (simple rules, runs fully on-device)
    const acts=[];
    const topBacklog=backlog.filter(b=>!b.done).sort((a,b)=>({high:0,medium:1,low:2}[a.priority||'medium'])-({high:0,medium:1,low:2}[b.priority||'medium']))[0];
    if(!tasks.length)acts.push({i:'📝',t:"Plan today — add your first task",s:'Timetable',h:'/timetable'});
    else if(pendingTasks)acts.push({i:'✅',t:`Finish ${pendingTasks} pending task${pendingTasks>1?'s':''}`,s:`${doneTasks}/${tasks.length} done`,h:'/timetable'});
    if(topBacklog)acts.push({i:'🧠',t:`Clear backlog: ${topBacklog.text}`,s:`${(topBacklog.priority||'medium')} priority`,h:null,fn:'focus'});
    if(!tests.length)acts.push({i:'📊',t:'Log your first test to see trends',s:'Test analysis',h:'/test-analysis'});
    else if(avgTestPct<65)acts.push({i:'🎯',t:'Review mistakes from your last test',s:`Avg score ${avgTestPct}%`,h:'/test-analysis'});
    if(!dppTotal)acts.push({i:'📓',t:'Log your first DPP questions',s:'DPP logger',h:'/dpp'});
    if(syllabusPct<50)acts.push({i:'📚',t:'Update your syllabus progress',s:`${syllabusPct}% covered`,h:'/syllabus'});
    if(!todayMin)acts.push({i:'⏱',t:'Start a 25-minute focus session',s:'Focus timer',h:null,fn:'focus'});
    if(!acts.length)acts.push({i:'🔥',t:'You are on track — keep your streak alive',s:'Great work',h:null,fn:'focus'});
    const aEl=document.getElementById('hubActions');
    const arrow='<svg class="hub-act-go" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    if(aEl)aEl.innerHTML=acts.slice(0,3).map(a=>{
        const inner=`<span class="hub-act-ico">${a.i}</span><span class="hub-act-t">${esc(a.t)}<small>${esc(a.s)}</small></span>${arrow}`;
        return a.h?`<a class="hub-act" href="${a.h}">${inner}</a>`:`<button class="hub-act" type="button" onclick="openPomodoro()">${inner}</button>`;
    }).join('');

    renderBacklog(backlog);
}

function renderBacklog(backlogItems){
    const host=document.getElementById('backlogList');
    if(!host)return;
    const active=backlogItems.filter(b=>!b.done).sort((a,b)=>({high:0,medium:1,low:2}[a.priority||'medium'])-({high:0,medium:1,low:2}[b.priority||'medium']));
    if(!active.length){
        host.innerHTML='<div class="empty-card" style="padding:1rem 0.4rem;"><div class="empty-ico">🧠</div><div class="empty-t">No backlog items · Add your next bottleneck</div></div>';
        return;
    }
    host.innerHTML=active.slice(0,4).map((item,idx)=>`<div class="backlog-row" style="margin-bottom:6px;">
        <span class="backlog-pri ${esc(item.priority||'medium')}">${esc((item.priority||'medium').toUpperCase())}</span>
        <div style="flex:1;font-size:0.76rem;">${esc(item.text||'Untitled backlog')}</div>
        <button class="backlog-done" onclick="markBacklogDone('${esc(item.id||String(idx))}')">DONE</button>
    </div>`).join('')+(active.length>4?`<div class="hub-muted">+ ${active.length-4} more backlog item(s)</div>`:'');
}

function openBacklogModal(e){
    if(e)e.preventDefault();
    document.getElementById('backlogModal')?.classList.add('open');
    setTimeout(()=>document.getElementById('backlogTextInput')?.focus(),60);
}
function closeBacklogModal(){document.getElementById('backlogModal')?.classList.remove('open');}
function saveBacklogModal(){
    const text=(document.getElementById('backlogTextInput')?.value||'').trim();
    const priority=(document.getElementById('backlogPriorityInput')?.value||'medium').toLowerCase();
    if(!text){showToastMsg('Enter backlog item first.');return;}
    const backlog=readJsonArray('buddy_backlog');
    backlog.unshift({id:`b_${Date.now()}`,text:text.trim(),priority,done:false,createdAt:new Date().toISOString()});
    localStorage.setItem('buddy_backlog',JSON.stringify(backlog));
    document.getElementById('backlogTextInput').value='';
    document.getElementById('backlogPriorityInput').value='medium';
    closeBacklogModal();
    loadStudyHub();
    showToastMsg('🧠 Added to backlog.');
}

function markBacklogDone(id){
    const backlog=readJsonArray('buddy_backlog').map(item=>item.id===id?{...item,done:true,doneAt:new Date().toISOString()}:item);
    localStorage.setItem('buddy_backlog',JSON.stringify(backlog));
    loadStudyHub();
}

setInterval(()=>{if(_cu&&_sm==='cloud')syncToCloud();},30000);

// Canvas
const cv=document.getElementById('canvas-bg'),ct=cv.getContext('2d');let W=innerWidth,H=innerHeight;
const pts=Array.from({length:50},()=>({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.4+0.2,vx:(Math.random()-.5)*.18,vy:(Math.random()-.5)*.18,col:Math.random()>0.5?'91,110,245':'245,166,35',a:Math.random()*.09+.015}));
(function draw(){ct.clearRect(0,0,W,H);pts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;ct.beginPath();ct.arc(p.x,p.y,p.r,0,Math.PI*2);ct.fillStyle=`rgba(${p.col},${p.a})`;ct.fill();});requestAnimationFrame(draw);})();
window.addEventListener('resize',()=>{W=cv.width=innerWidth;H=cv.height=innerHeight;});cv.width=W;cv.height=H;
</script>

