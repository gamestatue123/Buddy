// Clock
function updateClock(){
    const now=new Date();
    const ct=document.getElementById('clockTime'),cd=document.getElementById('clockDate'),cdy=document.getElementById('clockDay'),hg=document.getElementById('heroGreeting');
    if(!ct)return;
    ct.textContent=`${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
    const D=['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'],M=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
    if(cd)cd.textContent=`${D[now.getDay()].slice(0,3)} ${String(now.getDate()).padStart(2,'0')} ${M[now.getMonth()]}`;
    if(cdy)cdy.textContent=D[now.getDay()];
    const h=now.getHours();if(hg)hg.textContent=h<5?'GOOD NIGHT':h<12?'GOOD MORNING':h<17?'GOOD AFTERNOON':'GOOD EVENING';
}
