      <!-- prompt box -->
      <div style="margin-bottom:1rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--fg3);">📋 THE PROMPT — COPY AND PASTE INTO YOUR AI</div>
          <button id="copyPromptBtn" onclick="copyImportPrompt()" style="display:flex;align-items:center;gap:5px;padding:5px 12px;background:rgba(167,139,250,0.14);border:1px solid rgba(167,139,250,0.3);border-radius:50px;color:var(--vio);font-family:'JetBrains Mono',monospace;font-size:0.6rem;letter-spacing:0.06em;cursor:pointer;transition:all 0.18s;" onmouseover="this.style.background='rgba(167,139,250,0.25)'" onmouseout="this.style.background='rgba(167,139,250,0.14)'">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span id="copyPromptLabel">COPY PROMPT</span>
          </button>
        </div>
        <div style="background:var(--ink);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:13px 15px;font-family:'JetBrains Mono',monospace;font-size:0.62rem;color:var(--fg2);line-height:1.8;white-space:pre-wrap;max-height:240px;overflow-y:auto;scrollbar-width:thin;user-select:text;" id="importPromptDisplay"></div>
      </div>

      <!-- example output -->
      <details style="margin-bottom:0.2rem;">
        <summary style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;letter-spacing:0.08em;color:var(--fg3);cursor:pointer;padding:8px 0;user-select:none;">▸ SEE EXAMPLE OUTPUT</summary>
        <div style="background:var(--ink);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:13px 15px;font-family:'JetBrains Mono',monospace;font-size:0.6rem;color:var(--grn);line-height:1.8;margin-top:6px;overflow-x:auto;white-space:pre;">[
  {
    "testName": "JEE Main Mock #1",
    "date": "2026-03-15",
    "physics": 72,
    "physicsMax": 100,
    "chemistry": 68,
    "chemistryMax": 100,
    "maths": 80,
    "mathsMax": 100,
    "maxMarks": 300,
    "totalQuestions": 90,
    "rank": "1240"
  }
]</div>
      </details>

    </div>
  </div>
</div>

<script>
(function(){
  const IMPORT_PROMPT = `Convert the following test results into a valid JSON array. Generate a downloadable .json file named results.json containing this data.
Output Requirements (STRICT)
Output must be pure JSON only
Do NOT include explanations, comments, or markdown
Do NOT wrap the JSON in code blocks
Do NOT prepend or append any text
Ensure the output is valid JSON that can be directly saved as a .json file
The response must start with [ and end with ]
Use double quotes (") for all keys and string values
No trailing commas
Schema for each object:

{
"testName": "Name of the test (e.g. JEE Main Mock #3)",
"date": "YYYY-MM-DD",
"physics": number,
"physicsMax": number,
"chemistry": number,
"chemistryMax": number,
"maths": number,
"mathsMax": number,
"maxMarks": number,
"totalQuestions": number,
"rank": "string"
}

Rules for Missing Data:
Use 0 for any missing numeric values
Use "" for missing text values
Additional Constraints:
Always return an array, even if there is only one test
Preserve numeric types (no quotes around numbers)
Dates must strictly follow YYYY-MM-DD format
If the input contains multiple tests, include all of them
Final Instruction:

Return ONLY the JSON array. The output must be directly usable as a .json file without any modification.`;

  // Populate the prompt display on load
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('importPromptDisplay');
    if (el) el.textContent = IMPORT_PROMPT;
  });

  window.openImportGuide = function() {
    const o = document.getElementById('importGuideOverlay');
    o.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    // populate in case DOMContentLoaded already fired
    const el = document.getElementById('importPromptDisplay');
    if (el && !el.textContent) el.textContent = IMPORT_PROMPT;
  };

  window.closeImportGuide = function() {
    document.getElementById('importGuideOverlay').style.display = 'none';
    document.body.style.overflow = '';
  };

  window.copyImportPrompt = async function() {
    try {
      await navigator.clipboard.writeText(IMPORT_PROMPT);
    } catch(e) {
      // Fallback for older Android WebViews
      const ta = document.createElement('textarea');
      ta.value = IMPORT_PROMPT;
      ta.style.cssText = 'position:fixed;top:-9999px;opacity:0;';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
    const btn = document.getElementById('copyPromptBtn');
    const lbl = document.getElementById('copyPromptLabel');
    if (lbl) lbl.textContent = '✓ COPIED!';
    if (btn) { btn.style.background = 'rgba(45,207,158,0.18)'; btn.style.borderColor = 'rgba(45,207,158,0.35)'; btn.style.color = 'var(--grn)'; }
    setTimeout(() => {
      if (lbl) lbl.textContent = 'COPY PROMPT';
      if (btn) { btn.style.background = 'rgba(167,139,250,0.14)'; btn.style.borderColor = 'rgba(167,139,250,0.3)'; btn.style.color = 'var(--vio)'; }
    }, 2200);
  };

  // Close on backdrop click
  document.getElementById('importGuideOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeImportGuide();
  });

  // Close on Escape
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && document.getElementById('importGuideOverlay').style.display === 'flex') closeImportGuide();
  });
})();
</script>
