              <div style="font-size:0.76rem;color:var(--fg2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(p.name||'Test')}</div>
              <div style="font-family:var(--fm);font-size:0.54rem;color:var(--fg3);margin-top:1px;">${pd.toLocaleDateString('en-IN',{day:'numeric',month:'short'})} · ${daysAgo}d ago</div>
            </div>
            <a href="/test-analysis" style="font-family:var(--fm);font-size:0.56rem;color:var(--acc);text-decoration:none;letter-spacing:0.04em;flex-shrink:0;">ANALYSE →</a>
          </div>
        </div>`;
    }

    body.innerHTML=html;
}

